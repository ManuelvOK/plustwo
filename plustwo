class ChangeError(Exception):
    """An error the user can fix, shown without a traceback."""


@dataclass
class Message:
    """One message in a comment thread.

    A reviewer's message starts as a draft (sent is False), which only the
    reviewer sees, until the reviewer sends it. Like in Gerrit, a message
    can resolve its thread or make it unresolved again: unresolved is
    True or False then, None leaves the thread as it is.
    """
    author: str
    text: str
    sent: bool = True
    unresolved: bool | None = None
    # When it was sent, seconds since 1970. 0 for drafts and older notes.
    time: int = 0


@dataclass
class Comment:
    """A comment thread on one place of a change.

    place is a file, or a file and a line like src/main.cc:12. The line
    counts in the new version of the file, or with side "old" in the old
    version, for lines the change removed.

    Like in Gerrit, the thread is unresolved or resolved as its last sent
    message that says so has set it, unresolved if none did.
    """
    number: int
    place: str
    patch_set: int
    messages: list[Message] = field(default_factory=list)
    side: str = NEW_SIDE
    # Never changes, unlike a place. Numbers don't change either: deleting a
    # draft thread leaves a gap.
    id: str = ''

    @property
    def status(self):
        """unresolved or resolved, from the sent messages."""
        flags = [message.unresolved for message in self.messages
                 if message.sent and message.unresolved is not None]
        return UNRESOLVED if not flags or flags[-1] else RESOLVED

    def is_unresolved(self):
        """Whether the thread is unresolved, drafts left out."""
        return UNRESOLVED == self.status

    def draft_status(self):
        """The status the thread gets when its draft is sent, None if the
        draft doesn't change it or there is no draft.
        """
        if not self.has_draft() or self.messages[-1].unresolved is None:
            return None
        return UNRESOLVED if self.messages[-1].unresolved else RESOLVED

    def place_label(self):
        """The place for display, marked when it is in the old version."""
        return self.place + (' (old)' if OLD_SIDE == self.side else '')

    def is_draft(self):
        """Whether the thread exists only as the reviewer's draft so far."""
        return all(not message.sent for message in self.messages)

    def has_draft(self):
        """Whether the thread ends with an unsent reviewer message."""
        return bool(self.messages) and not self.messages[-1].sent

    def is_unanswered(self):
        """Whether the last sent message is the reviewer's."""
        sent = [message for message in self.messages if message.sent]
        return bool(sent) and REVIEWER == sent[-1].author


@dataclass
class Vote:
    """A vote on one patch set, like Code-Review+2 by the reviewer."""
    label: str
    value: int
    by: str
    patch_set: int
    message: str = ''
    # The patch set the vote was copied from, None if given on this one
    copied_from: int | None = None
    time: int = 0

    def copied(self, patch_set):
        """This vote copied to a newer patch set."""
        return Vote(label=self.label, value=self.value, by=self.by, patch_set=patch_set,
                    message=self.message, copied_from=self.copied_from or self.patch_set,
                    time=self.time)


@dataclass
class Change:
    """A commit with a Change-Id: its review state, threads and patch sets."""
    change_id: str
    commit: str
    subject: str
    topic: str
    comments: list[Comment]
    patch_sets: dict[int, str]
    votes: list[Vote] = field(default_factory=list)
    verified_required: bool = False
    # The reviewer's rebase failed with conflicts, the author has to do it.
    # Kept on the top change of the stack.
    rebase_requested: bool = False
    # The patch set the reviewer's last rebase made, 0 if none
    rebased_patch_set: int = 0
    # Upload times of the patch sets: number -> seconds since 1970
    uploads: dict[int, int] = field(default_factory=dict)
    # Files the reviewer marked reviewed: path -> hash of the file's diff
    reviewed: dict[str, str] = field(default_factory=dict)
    # Who uploaded the patch sets: number -> name, see current_user()
    uploaders: dict[int, str] = field(default_factory=dict)
    # Work in progress, like Gerrit's WIP: shown, but not to be reviewed
    wip: bool = False
    # The repository's working tree and its name, for showing several
    repository: str | None = None
    repo: str = ''

    def uploader(self):
        """Who uploaded the latest patch set, '' if unknown."""
        return self.uploaders.get(self.latest_patch_set(), '')

    def sections(self, user):
        """The dashboard sections the change belongs to, for this user."""
        mine = user == self.uploader()
        turn = self.turn()
        sections = []
        if (REVIEWER_TURN == turn and not mine) or (AUTHOR_TURN == turn and mine) or (
                SUBMITTABLE == turn and not mine):
            sections.append('your-turn')
        if any(comment.has_draft() for comment in self.comments):
            sections.append('drafts')
        if self.wip:
            sections.append('wip')
        sections.append('outgoing' if mine else 'incoming')
        return sections

    def comment(self, number):
        """The thread with this number, None if there is none."""
        return next((comment for comment in self.comments if number == comment.number), None)

    def turn(self):
        """Whose turn it is, like Gerrit's attention set: whoever acted last
        hands it to the other side. The reviewer acts by sending and voting,
        the author by uploading and answering. SUBMITTABLE when approved and
        nothing is unresolved.
        """
        if not self.patch_sets:
            return AUTHOR_TURN
        if self.wip:
            return WIP_TURN
        if not self.submit_problems() and not self.unfinished_comments():
            return SUBMITTABLE
        if self.rebase_requested:
            return AUTHOR_TURN
        sent = [message for comment in self.comments for message in comment.messages
                if message.sent]
        reviewer = max([message.time for message in sent if REVIEWER == message.author]
                       + [vote.time for vote in self.votes
                          if REVIEWER == vote.by and not vote.copied_from], default=0)
        author = max([message.time for message in sent if AUTHOR == message.author]
                     + list(self.uploads.values()), default=0)
        if reviewer > author:
            return AUTHOR_TURN
        if reviewer == author == 0 and any(comment.is_unanswered()
                                           for comment in self.unfinished_comments()):
            return AUTHOR_TURN
        return REVIEWER_TURN

    def latest_patch_set(self):
        """Number of the newest patch set, 0 if none is uploaded yet."""
        return max(self.patch_sets, default=0)

    def is_uploaded(self):
        """Whether the current commit is the newest patch set."""
        latest = self.latest_patch_set()
        return 0 != latest and self.patch_sets[latest] == self.commit

    def short_id(self):
        """The Change-Id shortened for display, like I3f2a9c1."""
        return self.change_id[:8]

    def state(self):
        """Review state for display, named like in Gerrit: New, In-Review or
        Submitted. Changes in a stack are never submitted, they leave the
        stack when they are.
        """
        return 'In-Review' if self.patch_sets else 'New'

    def unfinished_comments(self):
        """Sent threads that are still unresolved."""
        return [comment for comment in self.comments
                if comment.is_unresolved() and not comment.is_draft()]

    def current_votes(self, label):
        """The votes of a label on the latest patch set."""
        latest = self.latest_patch_set()
        return [vote for vote in self.votes
                if label == vote.label and latest and latest == vote.patch_set]

    def label_value(self, label):
        """A label's summary for display, as Gerrit shows it: the lowest
        value if someone gave it, else the highest if someone gave it, else
        a negative vote before a positive one. 0 without votes.
        """
        values = [vote.value for vote in self.current_votes(label)]
        low, high = LABEL_RANGES[label]
        if not values:
            return 0
        if low in values or high in values:
            return low if low in values else high
        return min(values) if min(values) < 0 else max(values)

    def is_approved(self, label):
        """Whether the latest patch set has the label's highest vote and
        not its lowest, which submitting needs.
        """
        values = [vote.value for vote in self.current_votes(label)]
        low, high = LABEL_RANGES[label]
        return high in values and low not in values

    def submit_problems(self):
        """What keeps this change from being submitted, as messages."""
        name = self.short_id()
        if not self.patch_sets:
            return [f'{name} has no patch set yet, waiting for the author']
        problems = []
        if self.wip:
            problems.append(f'{name} is work in progress, waiting for the author')
        if not self.is_uploaded():
            problems.append(f'{name} changed since its last patch set, waiting for the author')
        labels = [CODE_REVIEW] + ([VERIFIED] if self.verified_required else [])
        for label in labels:
            if not self.is_approved(label):
                value = self.label_value(label)
                problems.append(f'{name} needs {label}{LABEL_RANGES[label][1]:+d}'
                                + (f', it has {label}{value:+d}' if value else '')
                                + (', from a check' if VERIFIED == label else ''))
        return problems


# ── git helpers ───────────────────────────────────────────────────────────

# The repository commands without one act on: None for the working
# directory. A frontend showing changes of several repositories sets it to
# the one of the change it acts on. Per thread, so the web server's
# requests don't mix.
_REPOSITORY = contextvars.ContextVar('repository', default=None)


def use_repository(repository):
    """Makes later calls without a repository act on this one."""
    _REPOSITORY.set(str(repository) if repository else None)


def current_repository(repository=None):
    """The repository a call acts on: the given one, else the one set by
    use_repository(), else None for the working directory.
    """
    return repository or _REPOSITORY.get()


def git_command(repository=None):
    """The start of a git command line running in a repository."""
    repository = current_repository(repository)
    return ['git'] + (['-C', str(repository)] if repository else [])


def git(*arguments, input_text=None, check=True, repository=None):
    """Runs git and returns its output without the final newline."""
    command = git_command(repository) + list(arguments)
    # Files need not be UTF-8, so bytes that aren't become replacement
    # characters instead of an error.
    result = subprocess.run(command, input=input_text, encoding='utf-8', errors='replace',
                            capture_output=True)
    if check and 0 != result.returncode:
        raise ChangeError(result.stderr.strip() or f'git {arguments[0]} failed')
    return result.stdout.rstrip('\n')


# Object names that never change: a full hash, or the parent of one. What
# git says about them can be kept. Names like main or HEAD can't.
IMMUTABLE_NAME = re.compile(r'^[0-9a-f]{40}(\^|~[0-9]*)*$')
# How many results each cached function keeps
CACHE_SIZE = 2048


def cached_for_objects(*positions):
    """Keeps a function's results, the CACHE_SIZE latest, when the
    arguments at these positions are names of objects that never change
    (see IMMUTABLE_NAME). Commits and blobs don't change, so neither do
    their diffs. The repository a call acts on is part of the key.
    Callers must not change what they get.
    """
    def decorate(function):
        @functools.lru_cache(maxsize=CACHE_SIZE)
        def cached(repository, arguments, keywords):
            return function(*arguments, **dict(keywords))

        @functools.wraps(function)
        def wrapper(*arguments, **keywords):
            if all(position < len(arguments) and IMMUTABLE_NAME.match(str(arguments[position]))
                   for position in positions):
                try:
                    return cached(current_repository(keywords.get('repository')), arguments,
                                  tuple(sorted(keywords.items())))
                except TypeError:
                    # An argument that can't be a key
                    pass
            return function(*arguments, **keywords)

        wrapper.cache_clear = cached.cache_clear
        return wrapper
    return decorate


# ── settings ──────────────────────────────────────────────────────────────

# Settings that lived in git config before, read from there as a fallback
LEGACY_SETTINGS = {'review.base': 'change.base'}


def user_config_path():
    """The user's settings file, in git config syntax."""
    home = os.environ.get('XDG_CONFIG_HOME') or str(Path.home() / '.config')
    return Path(home) / 'plustwo' / 'config'


def repository_config_path(repository=None):
    """The repository's settings file, in git config syntax, inside .git."""
    repository = current_repository(repository)
    path = Path(git('rev-parse', '--git-path', 'plustwo/config', repository=repository))
    return Path(repository) / path if repository and not path.is_absolute() else path.absolute()


def config_files(repository=None):
    """The settings files, the one that wins first: the repository's, then
    the user's. The repository's only inside a repository.
    """
    inside = subprocess.run([*git_command(repository),
                             'rev-parse', '--git-dir'], capture_output=True).returncode == 0
    return ([repository_config_path(repository)] if inside else []) + [user_config_path()]


def setting(key, default=None, repository=None):
    """A setting like review.base: from the repository's file, else the
    user's, else (for older settings) git config, else default. The files
    use git config syntax and are read with git config --file, so no
    setting of ours goes into git's own config.
    """
    for path in config_files(repository):
        if path.exists():
            value = git('config', '--file', str(path), '--get', key, check=False)
            if value:
                return value
    legacy = LEGACY_SETTINGS.get(key)
    if legacy:
        value = git('config', legacy, check=False, repository=repository)
        if value:
            return value
    return default


def settings_section(section, repository=None):
    """All settings of a section like keys, as {name: value}, the
    repository's over the user's.
    """
    values = {}
    for path in reversed(config_files(repository)):
        if not path.exists():
            continue
        output = git('config', '--file', str(path), '--get-regexp', rf'^{re.escape(section)}\.',
                     check=False)
        for line in filter(None, output.split('\n')):
            key, _, value = line.partition(' ')
            values[key[len(section) + 1:]] = value
    return values


def set_setting(key, value, user=False, repository=None):
    """Stores a setting in the repository's file, or with user in the
    user's. Value None removes it.
    """
    path = user_config_path() if user else repository_config_path(repository)
    if value is None:
        if path.exists():
            git('config', '--file', str(path), '--unset', key, check=False)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    git('config', '--file', str(path), key, value)


def list_settings(repository=None):
    """Every setting as "key=value (file)" lines, the user's first."""
    lines = []
    for path in reversed(config_files(repository)):
        if path.exists():
            output = git('config', '--file', str(path), '--list', check=False)
            lines += [f'{line}  ({path})' for line in filter(None, output.split('\n'))]
    return lines


def migrate_settings(repository=None):
    """Moves settings of older versions out of the repository's git config
    into its own file. Ones in the user's global git config are left
    alone, they still count as a fallback. Returns the moved keys.
    """
    moved = []
    for key, legacy in LEGACY_SETTINGS.items():
        value = git('config', '--local', legacy, check=False, repository=repository)
        if not value:
            continue
        path = repository_config_path(repository)
        if not (path.exists() and git('config', '--file', str(path), '--get', key, check=False)):
            set_setting(key, value, repository=repository)
        git('config', '--local', '--unset', legacy, repository=repository)
        moved.append(f'{legacy} -> {key}')
    return moved


# ── state: registered repositories, lists, the dashboard ───────────────

# What the tool remembers, as opposed to what the user configures: files in
# git config syntax below $XDG_STATE_HOME/plustwo, read and written with
# git config --file.
DASHBOARD_SECTIONS = ('your-turn', 'drafts', 'wip', 'outgoing', 'incoming')
SECTION_TITLES = {'your-turn': 'Your turn', 'drafts': 'Has drafts', 'wip': 'Work in progress',
                  'outgoing': 'Outgoing', 'incoming': 'Incoming'}


def state_path(name):
    """A state file, like repos or dashboard."""
    home = os.environ.get('XDG_STATE_HOME') or str(Path.home() / '.local' / 'state')
    return Path(home) / 'plustwo' / name


def state_values(name, key):
    """All values of a key in a state file."""
    path = state_path(name)
    if not path.exists():
        return []
    output = git('config', '--file', str(path), '--get-all', key, check=False)
    return [value for value in output.split('\n') if value]


def state_regexp(name, pattern):
    """(key, value) pairs of a state file whose keys match a pattern."""
    path = state_path(name)
    if not path.exists():
        return []
    output = git('config', '--file', str(path), '--get-regexp', pattern, check=False)
    return [tuple(line.partition(' ')[::2]) for line in output.split('\n') if line]


def set_state(name, key, value, add=False):
    """Sets a key of a state file, adds a value with add, removes all of
    its values with value None.
    """
    path = state_path(name)
    if value is None:
        if path.exists():
            git('config', '--file', str(path), '--unset-all', key, check=False)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    git('config', '--file', str(path), *(['--add'] if add else []), key, value)


def toplevel(repository=None):
    """The absolute path of a repository's working tree, None outside one."""
    result = subprocess.run([*git_command(repository), 'rev-parse', '--show-toplevel'],
                            capture_output=True, text=True)
    return result.stdout.strip() or None if 0 == result.returncode else None


def registered_repositories():
    """The registered repositories: name -> path, in the order of the file."""
    return {key[len('repo.'):-len('.path')]: value
            for key, value in state_regexp('repos', r'^repo\..*\.path$')}


def repository_lists():
    """The lists of repositories: name -> [repository names]."""
    lists = {}
    for key, value in state_regexp('repos', r'^list\..*\.repo$'):
        lists.setdefault(key[len('list.'):-len('.repo')], []).append(value)
    return lists


def register_repository(path='.', name=None, list_name=None, unique=False):
    """Registers a repository for the dashboard, under its directory's name
    unless name is given, and adds it to a list. A name whose repository is
    gone is taken over. With unique, a taken name gets a number instead of
    an error, e.g. repo-2. Returns the name.
    """
    root = toplevel(path)
    if root is None:
        raise ChangeError(f'{path} is not a git repository')
    known = registered_repositories()
    existing = next((known_name for known_name, known_path in known.items()
                     if known_path == root), None)
    name = existing or name or Path(root).name
    if existing is None:
        if name in known and not Path(known[name]).exists():
            del known[name]
        if unique:
            stem, number = name, 2
            while name in known:
                name, number = f'{stem}-{number}', number + 1
        if name in known:
            raise ChangeError(f'a repository named {name} is registered already, '
                              'choose another with --name')
        set_state('repos', f'repo.{name}.path', root)
    if list_name and name not in repository_lists().get(list_name, []):
        set_state('repos', f'list.{list_name}.repo', name, add=True)
    return name


def unregister_repository(name):
    """Forgets a registered repository, also in every list."""
    if name not in registered_repositories():
        raise ChangeError(f'no registered repository {name}')
    path = state_path('repos')
    git('config', '--file', str(path), '--remove-section', f'repo.{name}', check=False)
    for list_name, names in repository_lists().items():
        if name in names:
            git('config', '--file', str(path), '--unset-all', f'list.{list_name}.repo',
                f'^{re.escape(name)}$', check=False)


def review_repositories(list_name=None):
    """The repositories reviews are shown for: the registered ones (of a
    list, if given) that still exist. Without any registered, the one of
    the working directory, so nothing changes until the first register.
    The working directory's repository comes along when it isn't
    registered, as long as no list is asked for.
    """
    known = registered_repositories()
    if list_name:
        names = repository_lists().get(list_name)
        if names is None:
            raise ChangeError(f'no list {list_name}')
        return [known[name] for name in names if name in known and Path(known[name]).exists()]
    paths = [path for path in known.values() if Path(path).exists()]
    here = toplevel()
    if here and here not in paths:
        paths.insert(0, here)
    return paths


def current_user():
    """Who acts: PLUSTWO_USER (agents set it to agent), else git's user.name,
    read once per process.
    """
    return os.environ.get('PLUSTWO_USER') or git_user_name()


@functools.lru_cache(maxsize=1)
def git_user_name():
    """git's user.name, 'unknown' without one. The dashboard asks for every
    change, so git runs only once.
    """
    return git('config', 'user.name', check=False) or 'unknown'


def dashboard_order():
    """The dashboard's sections in the user's order. Unknown names are
    left out, sections missing from the saved order come at the end.
    """
    saved = [name for value in state_values('dashboard', 'dashboard.sections')
             for name in value.split(',') if name in DASHBOARD_SECTIONS]
    return saved + [name for name in DASHBOARD_SECTIONS if name not in saved]


def move_section(name, steps):
    """Moves a dashboard section up (steps < 0) or down and saves the order."""
    order = dashboard_order()
    index = order.index(name)
    target = max(0, min(index + steps, len(order) - 1))
    order.insert(target, order.pop(index))
    set_state('dashboard', 'dashboard.sections', ','.join(order))
    return order


def set_section_order(order):
    """Saves a whole order, e.g. from dragging in the web interface."""
    order = [name for name in order if name in DASHBOARD_SECTIONS]
    set_state('dashboard', 'dashboard.sections',
              ','.join(order + [name for name in DASHBOARD_SECTIONS if name not in order]))


def folded_sections():
    """The dashboard sections the user folded."""
    return {name for value in state_values('dashboard', 'dashboard.folded')
            for name in value.split(',') if name}


def toggle_section(name):
    """Folds or unfolds a dashboard section. Returns whether it is folded."""
    folded = folded_sections() ^ {name}
    set_state('dashboard', 'dashboard.folded', ','.join(sorted(folded)) or None)
    return name in folded


def base_branch(repository=None):
    """The branch reviewed changes go to: the setting review.base, else
    main.
    """
    return setting('review.base', DEFAULT_BASE, repository)


def refs_with_prefix(*prefixes, repository=None):
    """Refs below the prefixes: name -> object."""
    output = git('for-each-ref', '--format=%(refname) %(objectname)', *prefixes, check=False,
                 repository=repository)
    return dict(line.split(' ') for line in output.split('\n') if line)


def topics(repository=None):
    """The topics of the uploaded stacks, sorted."""
    return sorted(ref[len(STACK_PREFIX):] for ref in refs_with_prefix(STACK_PREFIX,
                                                                      repository=repository))


def stack_ref(topic):
    """The ref of an uploaded stack."""
    return STACK_PREFIX + topic


def commits_between(start, end, repository=None):
    """Commits on end that are not on start, oldest first."""
    output = git('rev-list', '--reverse', f'{start}..{end}', check=False, repository=repository)
    return output.split('\n') if output else []


def needs_rebase(topic, repository=None):
    """Whether the base branch moved on since the stack's last rebase."""
    return not is_ancestor(base_branch(repository), stack_ref(topic), repository)


def stack_commits(topic, repository=None):
    """Commits of an uploaded stack that are not on the base branch, oldest
    first.
    """
    return commits_between(base_branch(repository), stack_ref(topic), repository)


def topic_of_branch(branch):
    """The topic a local branch uploads to: its name, without a leading
    review/ (the branch names of older versions).
    """
    return branch[len(REVIEW_BRANCH_PREFIX):] if branch.startswith(REVIEW_BRANCH_PREFIX) else branch


def current_branch(repository=None):
    """The checked out branch, None on a detached HEAD."""
    return git('symbolic-ref', '--quiet', '--short', 'HEAD', check=False,
               repository=repository) or None


def is_ancestor(commit, other, repository=None):
    """Whether commit is on other."""
    return 0 == subprocess.run([*git_command(repository),
                                'merge-base', '--is-ancestor', commit, other],
                               capture_output=True).returncode


def change_id_of(commit, repository=None):
    """The Change-Id in a commit's message, None if it has none."""
    match = CHANGE_ID_PATTERN.search(git('log', '-1', '--format=%B', commit,
                                         repository=repository))
    return match.group(1) if match else None


def notes_version(repository=None):
    """Hash of the notes ref. It changes with every write to any note."""
    return git('rev-parse', '--verify', '--quiet', NOTES_REF, check=False, repository=repository)


def stack_version(repository=None):
    """All refs a review depends on, with their hashes. They change with
    every upload, rebase, submit and note write, so a viewer knows when to
    reload.
    """
    return git('for-each-ref', '--format=%(refname) %(objectname)',
               f'refs/heads/{base_branch(repository)}', NOTES_REF, PLUSTWO_PREFIX, check=False,
               repository=repository)


def read_note(commit, repository=None):
    """The review note of a commit as a dict, empty if it has none."""
    text = git('notes', f'--ref={NOTES_REF}', 'show', commit, check=False, repository=repository)
    return json.loads(text) if text else {}


def read_notes(commits, repository=None):
    """The review notes of several commits: commit -> dict, with two git
    calls for all of them.
    """
    if not commits:
        return {}
    blobs = {}
    output = git('notes', f'--ref={NOTES_REF}', 'list', check=False, repository=repository)
    for line in filter(None, output.split('\n')):
        blob, commit = line.split(' ')
        blobs[commit] = blob
    wanted = [(commit, blobs[commit]) for commit in commits if commit in blobs]
    if not wanted:
        return {}
    command = [*git_command(repository), 'cat-file', '--batch']
    data = subprocess.run(command, input=''.join(f'{blob}\n' for _, blob in wanted).encode(),
                          capture_output=True, check=True).stdout
    notes = {}
    for commit, _ in wanted:
        header, data = data.split(b'\n', 1)
        size = int(header.split()[2])
        notes[commit] = json.loads(data[:size].decode('utf-8', errors='replace') or '{}')
        data = data[size + 1:]
    return notes


def write_note(commit, note, repository=None):
    """Stores the review note of a commit."""
    git('notes', f'--ref={NOTES_REF}', 'add', '-f', '-F', '-', commit,
        input_text=json.dumps(note, indent=2) + '\n', repository=repository)


def patch_sets_of(change_id, repository=None):
    """Uploaded patch sets of a change: number -> commit."""
    output = git('for-each-ref', '--format=%(refname) %(objectname)',
                 f'{PATCH_SET_PREFIX}{change_id}/', repository=repository)
    patch_sets = {}
    for line in filter(None, output.split('\n')):
        ref, commit = line.split(' ')
        patch_sets[int(ref.rsplit('/', 1)[1])] = commit
    return patch_sets


@cached_for_objects(0)
def renames_of(commit, repository=None):
    """Files a commit renamed: new path -> old path."""
    output = git('diff-tree', '--no-commit-id', '-M', '-r', '--root', '--name-status', '-z',
                 commit, repository=repository)
    fields = output.split('\0')
    renames = {}
    index = 0
    while index < len(fields) and fields[index]:
        status = fields[index]
        if status.startswith(('R', 'C')):
            renames[fields[index + 2]] = fields[index + 1]
            index += 3
        else:
            index += 2
    return renames


@cached_for_objects(0)
def files_of(commit, repository=None):
    """Files a commit changes, with added and removed line counts.

    Returns a dict: path -> (added, removed). Binary files count as 0.
    """
    output = git('diff-tree', '--no-commit-id', '--numstat', '-r', '--root', commit,
                 repository=repository)
    files = {}
    for line in filter(None, output.split('\n')):
        added, removed, path = line.split('\t', 2)
        files[path] = (int(added) if added.isdigit() else 0,
                       int(removed) if removed.isdigit() else 0)
    return files


def line_at(commit, place, repository=None, side=NEW_SIDE):
    """The source line a place like src/main.cc:12 refers to, stripped.

    On the old side, the line is read from the commit's parent. Empty if
    the place has no line number or the file has no such line.
    """
    path, _, line = place.rpartition(':')
    if not path or not line.isdigit():
        return ''
    if COMMIT_MSG == path:
        if OLD_SIDE == side:
            return ''
        text = commit_message_text(commit, repository)
    elif OLD_SIDE == side:
        # A renamed file had its old path in the parent
        old_path = renames_of(commit, repository).get(path, path)
        text = git('show', f'{commit}^:{old_path}', check=False, repository=repository)
    else:
        text = git('show', f'{commit}:{path}', check=False, repository=repository)
    lines = text.split('\n')
    number = int(line)
    return lines[number - 1].strip() if 1 <= number <= len(lines) else ''


def commit_message_text(commit, repository=None):
    """The commit message as the file /COMMIT_MSG shows it: a header with
    parent, author and committer, like in Gerrit, then the message.
    """
    parents, author, author_date, committer, commit_date = git(
        'log', '-1', '--date=format:%Y-%m-%d %H:%M:%S %z',
        '--format=%P%n%an <%ae>%n%ad%n%cn <%ce>%n%cd', commit,
        repository=repository).split('\n')
    lines = [f'Parent:     {parent[:8]} '
             f'({git("log", "-1", "--format=%s", parent, repository=repository)})'
             for parent in parents.split()]
    lines += [f'Author:     {author}', f'AuthorDate: {author_date}',
              f'Commit:     {committer}', f'CommitDate: {commit_date}', '']
    message = git('log', '-1', '--format=%B', commit, repository=repository)
    return '\n'.join(lines) + '\n' + message.rstrip('\n') + '\n'


@cached_for_objects(0)
def commit_message_tree(commit, repository=None):
    """A tree with only the file COMMIT_MSG, holding commit_message_text().
    Without a commit, the empty tree. Two of these diff like two versions
    of a file, which git diff, delta and difftool all understand.
    """
    if commit is None:
        return git('hash-object', '-t', 'tree', '-w', '--stdin', input_text='',
                   repository=repository)
    blob = git('hash-object', '-w', '--stdin', input_text=commit_message_text(commit, repository),
               repository=repository)
    return git('mktree', input_text=f'100644 blob {blob}\t{COMMIT_MSG_NAME}\n',
               repository=repository)


@contextlib.contextmanager
def review_lock(repository=None):
    """Lets only one process change review notes at a time.

    The terminal user interface and the author's commands both read, change
    and write notes. Without the lock, one of two writes at the same moment
    would get lost.
    """
    repository = current_repository(repository)
    path = Path(git('rev-parse', '--git-path', 'git-change.lock', repository=repository))
    if repository and not path.is_absolute():
        path = Path(repository) / path
    with open(path, 'w') as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


# ── setup and the commit-msg hook ─────────────────────────────────────────

def init_repository():
    """Installs the commit-msg hook and makes notes follow amends and rebases."""
    path = Path(git('rev-parse', '--git-path', 'hooks/commit-msg'))
    existing = path.read_text(errors='replace') if path.exists() else None
    # Gerrit's own hook adds the same Change-Id trailer, so it stays.
    is_gerrit_hook = existing is not None and 'Change-Id' in existing and 'Gerrit' in existing
    if existing is not None and existing not in (HOOK_TEXT, *OLD_HOOK_TEXTS) and not is_gerrit_hook:
        raise ChangeError(f'{path} exists already and is not ours. Merge it by hand.')
    if not is_gerrit_hook or existing in (HOOK_TEXT, *OLD_HOOK_TEXTS):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(HOOK_TEXT)
        path.chmod(0o755)
    if NOTES_REF not in git('config', '--get-all', 'notes.rewriteRef', check=False).split('\n'):
        git('config', '--add', 'notes.rewriteRef', NOTES_REF)

    # Without an existing notes ref, every amend warns that it is invalid.
    # An empty notes commit makes it exist before the first comment.
    if not notes_version():
        empty_tree = git('hash-object', '-t', 'tree', '-w', '--stdin', input_text='')
        notes_commit = git('commit-tree', empty_tree, '-m', 'Notes created by plustwo init')
        git('update-ref', NOTES_REF, notes_commit)
    migrate_layout(remove_old=True)
    return migrate_settings()


def migrate_layout(remove_old=False, repository=None):
    """Moves the review state of older versions into refs/plustwo/.

    The patch sets are copied from refs/patchsets/. Every local review/
    branch becomes the stack of its topic, as far as its commits are
    uploaded, i.e. the latest patch sets of their changes. The branches
    stay. Only creates refs, so running it twice or at the same time does
    no harm. remove_old deletes the old patch set refs afterwards.
    """
    old = refs_with_prefix(OLD_PATCH_SET_PREFIX, repository=repository)
    new = refs_with_prefix(PATCH_SET_PREFIX, repository=repository)
    for ref, commit in old.items():
        target = PATCH_SET_PREFIX + ref[len(OLD_PATCH_SET_PREFIX):]
        if target not in new:
            git('update-ref', target, commit, repository=repository)
    base = base_branch(repository)
    branches = refs_with_prefix(f'refs/heads/{REVIEW_BRANCH_PREFIX}', repository=repository)
    stacks = refs_with_prefix(STACK_PREFIX, repository=repository)
    for ref in branches:
        topic = topic_of_branch(ref[len('refs/heads/'):])
        if stack_ref(topic) in stacks:
            continue
        top = None
        for commit in commits_between(base, ref, repository):
            change_id = change_id_of(commit, repository)
            patch_sets = patch_sets_of(change_id, repository) if change_id else {}
            if not patch_sets or patch_sets[max(patch_sets)] != commit:
                break
            top = commit
        if top:
            git('update-ref', stack_ref(topic), top, repository=repository)
    if remove_old:
        for ref, commit in old.items():
            git('update-ref', '-d', ref, commit, repository=repository)


def ensure_layout(repository=None):
    """Migrates a repository of an older version on first use, so nothing
    breaks before plustwo init runs again.
    """
    refs = refs_with_prefix(OLD_PATCH_SET_PREFIX, PLUSTWO_PREFIX, repository=repository)
    if refs and not any(ref.startswith(PLUSTWO_PREFIX) for ref in refs):
        migrate_layout(repository=repository)


def new_change_id(message):
    """A new Change-Id: "I" and 40 hex digits, as Gerrit's hook makes them."""
    seed = f'{time.time_ns()} {os.getpid()} {os.urandom(16).hex()} {message}'
    return 'I' + hashlib.sha1(seed.encode()).hexdigest()


def add_change_id(message_path):
    """Adds a Change-Id trailer to a commit message file if it has none.

    Like Gerrit's hook, it leaves out fixup!, squash! and amend! commits,
    which get folded into a commit that has its own Change-Id, and empty
    messages, which abort the commit anyway.
    """
    message = Path(message_path).read_text()
    meaningful = [line for line in message.split('\n') if not line.startswith('#')]
    if not ''.join(meaningful).strip():
        return
    if re.match(r'(fixup|squash|amend)! ', meaningful[0]):
        return
    if CHANGE_ID_PATTERN.search(message):
        return
    git('interpret-trailers', '--in-place', '--trailer',
        f'Change-Id: {new_change_id(message)}', message_path)


# ── changes ───────────────────────────────────────────────────────────────

def change_from(commit, topic, note, repository=None, change_id=None, subject=None,
                patch_sets=None):
    """Builds a Change from a commit of a stack and its note. change_id,
    subject and patch_sets are read from git unless given.
    """
    change_id = change_id or change_id_of(commit, repository)
    comments = []
    for comment in note.get('comments', []):
        messages = [Message(**message) for message in comment.pop('messages', [])]
        # Notes of older versions keep a status per thread instead
        old_status = OLD_STATUSES.get(comment.pop('status', None))
        sent = [message for message in messages if message.sent]
        if RESOLVED == old_status and sent and all(message.unresolved is None
                                                  for message in messages):
            sent[-1].unresolved = False
        comment.setdefault('id', hashlib.sha1(
            f'{change_id} {comment["number"]} {comment["place"]}'.encode()).hexdigest()[:12])
        comments.append(Comment(**comment, messages=messages))
    return Change(change_id=change_id,
                  commit=commit,
                  subject=subject if subject is not None else git(
                      'log', '-1', '--format=%s', commit, repository=repository),
                  topic=topic,
                  comments=comments,
                  patch_sets=(patch_sets if patch_sets is not None
                              else patch_sets_of(change_id, repository)),
                  votes=[Vote(**vote) for vote in note.get('votes', [])],
                  verified_required=note.get('verified_required', False),
                  rebase_requested=note.get('rebase_requested', False),
                  rebased_patch_set=note.get('rebased_patch_set', 0),
                  uploads={int(number): time for number, time in note.get('uploads', {}).items()},
                  reviewed=note.get('reviewed', {}),
                  uploaders={int(number): name
                             for number, name in note.get('uploaders', {}).items()},
                  wip=note.get('wip', False))


def note_of(change):
    """The note that stores a change's review."""
    return {'comments': [{'number': comment.number,
                          'id': comment.id,
                          'place': comment.place,
                          'patch_set': comment.patch_set,
                          'side': comment.side,
                          'messages': [vars(message) for message in comment.messages]}
                         for comment in change.comments],
            'votes': [vars(vote) for vote in change.votes],
            'verified_required': change.verified_required,
            'rebase_requested': change.rebase_requested,
            'rebased_patch_set': change.rebased_patch_set,
            'uploads': {str(number): time for number, time in change.uploads.items()},
            'reviewed': change.reviewed,
            'uploaders': {str(number): name for number, name in change.uploaders.items()},
            'wip': change.wip}


def changes_in_stack(repository=None):
    """All changes of the uploaded stacks, stack by stack and oldest first
    within a stack.
    """
    ensure_layout(repository)
    # A few git calls for all changes, not several per change
    all_patch_sets = {}
    output = git('for-each-ref', '--format=%(refname) %(objectname)', PATCH_SET_PREFIX,
                 repository=repository)
    for line in filter(None, output.split('\n')):
        ref, commit = line.split(' ')
        change_id, number = ref[len(PATCH_SET_PREFIX):].rsplit('/', 1)
        all_patch_sets.setdefault(change_id, {})[int(number)] = commit
    stacks = []
    base = base_branch(repository)
    for topic in topics(repository):
        output = git('log', '--reverse', '--format=%H%x1f%s%x1f%B%x1e',
                     f'{base}..{stack_ref(topic)}', check=False, repository=repository)
        for entry in filter(str.strip, output.split('\x1e')):
            commit, subject, body = entry.strip('\n').split('\x1f', 2)
            match = CHANGE_ID_PATTERN.search(body)
            if match:
                stacks.append((topic, commit, subject, match.group(1)))
    notes = read_notes([commit for _, commit, _, _ in stacks], repository)
    changes = [change_from(commit, topic, notes.get(commit, {}), repository, change_id, subject,
                           all_patch_sets.get(change_id, {}))
               for topic, commit, subject, change_id in stacks]
    root = toplevel(repository)
    for change in changes:
        change.repository = root
        change.repo = Path(root).name if root else ''
    return changes


def all_changes(list_name=None):
    """The changes of every repository reviews are shown for, see
    review_repositories(), repository by repository. Each change knows its
    repository and its registered name.
    """
    names = {path: name for name, path in registered_repositories().items()}
    changes = []
    for repository in review_repositories(list_name):
        for change in changes_in_stack(repository):
            change.repo = names.get(change.repository, change.repo)
            changes.append(change)
    return changes


def locate(change_id):
    """The repository a change is in review in: the working directory's if
    it has it, else the first registered one that has it. None when none
    has it, which means the working directory.
    """
    for repository in review_repositories():
        if git('for-each-ref', '--count=1', f'{PATCH_SET_PREFIX}{change_id}/', check=False,
               repository=repository):
            return repository
    return None


def find_change(reference, repository=None):
    """The change an overview number, a Change-Id prefix or repo:prefix
    refers to. Without a repository, over all repositories reviews are
    shown for (numbers count over all of them), and later calls without a
    repository act on the change's one.
    """
    if repository is not None:
        changes = changes_in_stack(repository)
    else:
        changes = all_changes()
        name, colon, rest = reference.rpartition(':')
        if colon:
            changes = [change for change in changes if name in (change.repo, Path(
                change.repository or '').name)]
            if not changes:
                raise ChangeError(f'no repository {name} with changes in review')
            reference = rest
    change = _find_in(changes, reference)
    if repository is None:
        use_repository(change.repository)
    return change


def _find_in(changes, reference):
    """The change of a list a number or a Change-Id prefix refers to."""
    if reference.isdigit():
        index = int(reference)
        if 1 <= index <= len(changes):
            return changes[index - 1]
        raise ChangeError(f'no change number {index}, the stacks have {len(changes)}')
    matches = [change for change in changes if change.change_id.startswith(reference)]
    if 1 == len(matches):
        return matches[0]
    if not matches:
        raise ChangeError(f'no change with a Change-Id starting with "{reference}"')
    raise ChangeError(f'"{reference}" fits several changes, give more of the Change-Id')


def update_change(change_id, edit, repository=None):
    """Changes a change's review under the lock and stores it.

    Reads the change fresh, because another process may have written since
    it was shown, and because an amend may have given it a new commit. Then
    calls edit(change), stores the result and returns what edit returned.
    """
    repository = current_repository(repository) or locate(change_id)
    with review_lock(repository):
        for change in changes_in_stack(repository):
            if change_id == change.change_id:
                result = edit(change)
                write_note(change.commit, note_of(change), repository)
                return result
    raise ChangeError(f'the change {change_id[:8]} is not in review any more')


def comment_of(change, number):
    """The thread with this number, or an error."""
    comment = change.comment(number)
    if comment is None:
        raise ChangeError(f'{change.short_id()} has no comment {number}')
    return comment


@cached_for_objects(0)
def tree_of(commit, repository=None):
    """The tree of a commit."""
    return git('rev-parse', f'{commit}^{{tree}}', repository=repository)


def patch_id(commit, repository=None):
    """The patch id of a commit: the same for the same diff, whatever its
    parent and message.
    """
    patch = git('diff-tree', '-p', '--root', commit, repository=repository)
    output = git('patch-id', '--stable', input_text=patch + '\n', repository=repository)
    return output.split(' ')[0] if output else ''


def rebased_tree(commit, parent, repository=None):
    """The tree of a commit replayed onto another parent, like a rebase
    without touching anything: a merge of the commit into parent with the
    commit's own parent as base. '' on a conflict, None when git can't do
    it in memory: that needs git 2.40 (merge-tree --merge-base).
    """
    result = subprocess.run([*git_command(repository), 'merge-tree', '--write-tree',
                             f'--merge-base={commit}^', parent, commit],
                            capture_output=True, text=True)
    # merge-tree exits with 1 on conflicts, anything else is an error.
    if 1 == result.returncode:
        return ''
    if 0 != result.returncode:
        return None
    return result.stdout.split('\n')[0].strip() or None


@cached_for_objects(0, 1)
def patch_set_kind(old, new, repository=None):
    """How a new patch set differs from the one before, like Gerrit's
    change kinds: no code change (the same files, e.g. a new message),
    trivial rebase (the same patch on another parent) or rework.

    Like Gerrit's ChangeKindCacheImpl, a trivial rebase is one where the
    old patch set, replayed onto the new one's parent, gives the new one's
    tree. So a change whose context moved because the change below edited
    nearby lines is one too. A conflict means rework. Without git 2.40
    it falls back to the patch ids, which see context changes as rework.
    """
    if tree_of(old, repository) == tree_of(new, repository):
        return NO_CODE_CHANGE
    if not (git('rev-parse', '--verify', '--quiet', f'{old}^', check=False,
                repository=repository)
            and git('rev-parse', '--verify', '--quiet', f'{new}^', check=False,
                    repository=repository)):
        # A root commit has no parent to rebase onto, like in Gerrit
        return REWORK
    rebased = rebased_tree(old, f'{new}^', repository)
    if rebased is not None:
        return TRIVIAL_REBASE if rebased and rebased == tree_of(new, repository) else REWORK
    if patch_id(old, repository) == patch_id(new, repository):
        return TRIVIAL_REBASE
    return REWORK


def is_kept(vote, kind):
    """Whether a new patch set of this kind keeps a vote, with Gerrit's
    default rules: Code-Review after a trivial rebase or without code change,
    Verified only without code change, and Code-Review-2 always.
    """
    if VERIFIED == vote.label:
        return NO_CODE_CHANGE == kind
    return kind in (NO_CODE_CHANGE, TRIVIAL_REBASE) or LABEL_RANGES[CODE_REVIEW][0] == vote.value


def add_patch_set(change, repository=None):
    """Saves a change's current commit as its next patch set and copies the
    votes it keeps. Returns (number, kind), kind None for the first one.
    """
    latest = change.latest_patch_set()
    number = latest + 1
    git('update-ref', f'{PATCH_SET_PREFIX}{change.change_id}/{number}', change.commit,
        repository=repository)
    kind = None
    if latest:
        kind = patch_set_kind(change.patch_sets[latest], change.commit, repository)
        change.votes += [vote.copied(number) for vote in change.current_votes(CODE_REVIEW)
                         + change.current_votes(VERIFIED) if is_kept(vote, kind)]
    change.patch_sets[number] = change.commit
    change.uploads[number] = int(time.time())
    change.uploaders[number] = current_user()
    return number, kind


def upload(branch=None, topic=None, repository=None, wip=None):
    """Uploads the stack of a local branch (the checked out one if None):
    its commits that are not on the base branch. Like a push to Gerrit's
    refs/for/, every commit that isn't its change's latest patch set yet
    becomes the next one, and the stack's ref points to the branch's top.

    topic defaults to the branch's name without a leading review/. The
    review of a change lives on its latest patch set, so a new patch set
    gets that note, whatever an amend copied to the local commit. A
    pending rebase request is cleared.

    A branch on top of another stack makes that stack bigger, under its
    topic, like a longer relation chain in Gerrit. wip True or False marks
    every change of the stack work in progress or ready, like Gerrit's %wip
    and %ready. Returns ([(change, patch set number, kind)] of the new
    patch sets, the topic, whether an existing stack grew).
    """
    with review_lock(repository):
        ensure_layout(repository)
        base = base_branch(repository)
        branch = branch or current_branch(repository)
        if branch is None and topic is None:
            raise ChangeError('HEAD is detached, check out a branch or give a topic')
        if base == branch:
            raise ChangeError(f'{base} is the base branch, upload from another branch')
        topic = topic or topic_of_branch(branch)
        tip = git('rev-parse', branch or 'HEAD', repository=repository)
        commits = commits_between(base, tip, repository)
        if not commits:
            raise ChangeError(f'{branch or "HEAD"} has no commits beyond {base}')
        change_ids = [change_id_of(commit, repository) for commit in commits]
        for commit, change_id in zip(commits, change_ids):
            if change_id is None:
                raise ChangeError(f'{commit[:8]} has no Change-Id. Run plustwo init, then '
                                  'amend it to get one.')
        in_review = {change.change_id: change.topic for change in changes_in_stack(repository)}
        grown = False
        if not git('rev-parse', '--verify', '--quiet', stack_ref(topic), check=False,
                   repository=repository):
            others = {in_review[change_id] for change_id in change_ids if change_id in in_review}
            if 1 == len(others):
                topic, grown = others.pop(), True
        elsewhere = {change_id: other for change_id, other in in_review.items()
                     if other != topic}
        for change_id in change_ids:
            if change_id in elsewhere:
                raise ChangeError(f'{change_id[:8]} is in review in the stack '
                                  f'{elsewhere[change_id]} already')

        uploaded = []
        marked = False
        for commit, change_id in zip(commits, change_ids):
            patch_sets = patch_sets_of(change_id, repository)
            latest = max(patch_sets, default=0)
            if latest and patch_sets[latest] == commit:
                note = read_note(commit, repository)
                if note.get('rebase_requested') or (wip is not None and wip != note.get('wip',
                                                                                        False)):
                    note['rebase_requested'] = False
                    if wip is not None:
                        note['wip'] = wip
                    write_note(commit, note, repository)
                    marked = True
                continue
            note = read_note(patch_sets[latest] if latest else commit, repository)
            change = change_from(commit, topic, note, repository)
            change.rebase_requested = False
            if wip is not None:
                change.wip = wip
            uploaded.append((change, *add_patch_set(change, repository)))
            write_note(commit, note_of(change), repository)
        old_top = git('rev-parse', '--verify', '--quiet', stack_ref(topic), check=False,
                      repository=repository)
        if not uploaded and old_top == tip and not marked:
            raise ChangeError(f'{topic} is uploaded already, nothing changed')
        git('update-ref', stack_ref(topic), tip, repository=repository)
        return uploaded, topic, grown


def branch_with_change(reference, repository=None):
    """The local branch holding a change, for an upload naming one: the
    checked out branch if it has it, else the only branch that has it.
    """
    base = base_branch(repository)
    current = current_branch(repository)
    if reference.isdigit():
        # Numbers count uploaded changes only. A new change has none yet,
        # so an old habit like "upload 3" uploads the checked out branch.
        try:
            change_id = find_change(reference, repository).change_id
        except ChangeError:
            if current and current != base:
                return current
            raise
    else:
        change_id = reference

    def has_change(branch):
        return any((change_id_of(commit, repository) or '').startswith(change_id)
                   for commit in commits_between(base, branch, repository))

    if current and current != base and has_change(current):
        return current
    branches = [ref[len('refs/heads/'):] for ref in refs_with_prefix('refs/heads/',
                                                                      repository=repository)]
    matches = [branch for branch in branches if branch != base and has_change(branch)]
    if 1 != len(matches):
        raise ChangeError(f'{len(matches)} local branches have the change {reference}, '
                          'check out the one to upload')
    return matches[0]


def changes_submitted_with(change, repository=None):
    """The changes a submit of this change submits: it and all changes below
    it in its stack, oldest first.
    """
    stack = [other for other in changes_in_stack(repository) if other.topic == change.topic]
    return stack[:[other.change_id for other in stack].index(change.change_id) + 1]


def submittable_in(stack, repository=None):
    """The Change-Ids of a stack's changes (oldest first) that submit()
    would submit now without force: they and the changes below them have
    their votes and nothing unresolved, and the base branch didn't move.
    """
    base = base_branch(repository)
    result = set()
    for change in stack:
        if change.submit_problems() or change.unfinished_comments():
            break
        if is_ancestor(base, change.commit, repository):
            result.add(change.change_id)
    return result


def worktrees_with(branch, repository=None):
    """Paths of the worktrees that have a branch checked out."""
    output = git('worktree', 'list', '--porcelain', repository=repository)
    paths, path = [], None
    for line in output.split('\n'):
        if line.startswith('worktree '):
            path = line[len('worktree '):]
        elif f'branch refs/heads/{branch}' == line:
            paths.append(path)
    return paths


def submit(change_id, force=False, repository=None):
    """Moves the base branch forward to a change, which submits it and every
    change below it in its stack, like Gerrit does with a chain. A stack
    with nothing left is removed. Local branches stay as they are, the
    author's plustwo pull catches up.

    Refuses when one of these changes lacks the votes it needs
    (Code-Review+2, Verified+1 if required), and when the base branch moved
    on and the stack needs a rebase first. Without force it also refuses
    while threads are unresolved, so no point gets lost. The interface uses
    force after listing those threads and asking.
    """
    repository = current_repository(repository) or locate(change_id)
    with review_lock(repository):
        change = next((change for change in changes_in_stack(repository)
                       if change_id == change.change_id), None)
        if change is None:
            raise ChangeError(f'the change {change_id[:8]} is not in review')
        submitted = changes_submitted_with(change, repository)
        problems = [problem for other in submitted for problem in other.submit_problems()]
        if problems:
            raise ChangeError('; '.join(problems))
        unfinished = [f'{other.short_id()} #{comment.number}' for other in submitted
                      for comment in other.unfinished_comments()]
        if unfinished and not force:
            raise ChangeError(f'unresolved threads: {", ".join(unfinished)}')

        base = base_branch(repository)
        if not is_ancestor(base, change.commit, repository):
            raise ChangeError(f'{base} moved on, rebase the stack {change.topic} onto it first')

        # The base branch is moved like a fast-forward merge. If it is checked
        # out here, merge keeps the working copy right, update-ref would not.
        # Checked out in another worktree, only that one can move it.
        here = git('rev-parse', '--show-toplevel', repository=repository)
        elsewhere = [path for path in worktrees_with(base, repository) if path != here]
        if elsewhere:
            raise ChangeError(f'{base} is checked out in {elsewhere[0]}, switch away from it '
                              'there first')
        if base == current_branch(repository):
            git('merge', '--ff-only', '--quiet', change.commit, repository=repository)
        else:
            git('update-ref', f'refs/heads/{base}', change.commit, repository=repository)

        top = git('rev-parse', stack_ref(change.topic), repository=repository)
        if top == change.commit:
            git('update-ref', '-d', stack_ref(change.topic), top, repository=repository)
        return submitted


ABANDONED_PREFIX = 'refs/plustwo/abandoned/'


def abandon_stack(topic, repository=None):
    """Abandons a stack, like Gerrit's Abandon: it leaves the dashboard,
    its patch sets and notes stay, restore_stack() brings it back. Whole
    stacks only, a change in the middle would leave the ones above it
    without their parent.
    """
    with review_lock(repository):
        top = git('rev-parse', '--verify', '--quiet', stack_ref(topic), check=False,
                  repository=repository)
        if not top:
            raise ChangeError(f'no stack {topic}')
        git('update-ref', f'{ABANDONED_PREFIX}{topic}', top, repository=repository)
        git('update-ref', '-d', stack_ref(topic), repository=repository)


def restore_stack(topic, repository=None):
    """Brings an abandoned stack back into review."""
    with review_lock(repository):
        top = git('rev-parse', '--verify', '--quiet', f'{ABANDONED_PREFIX}{topic}', check=False,
                  repository=repository)
        if not top:
            raise ChangeError(f'no abandoned stack {topic}')
        if git('rev-parse', '--verify', '--quiet', stack_ref(topic), check=False,
               repository=repository):
            raise ChangeError(f'a stack {topic} is in review again, upload it instead')
        git('update-ref', stack_ref(topic), top, repository=repository)
        git('update-ref', '-d', f'{ABANDONED_PREFIX}{topic}', repository=repository)


def dashboard(changes, user=None):
    """The dashboard like Gerrit's: [(section, [(number, change)])] in the
    user's order, every section, also empty ones. A change shows in every
    section it belongs to. number is its place in changes, from 1.
    """
    user = user or current_user()
    numbered = list(enumerate(changes, start=1))
    return [(section, [(number, change) for number, change in numbered
                       if section in change.sections(user)])
            for section in dashboard_order()]


def raw_commit(commit, repository=None):
    """A commit's author (name, email, date) and its message, exactly."""
    text = git('cat-file', 'commit', commit, repository=repository) + '\n'
    headers, _, message = text.partition('\n\n')
    author = next(line for line in headers.split('\n') if line.startswith('author '))
    match = re.match(r'author (.*) <(.*)> (\d+ [+-]\d{4})$', author)
    return match.groups(), message


def rebase_stack(topic, repository=None):
    """The reviewer's rebase of a stack onto the base branch, like Gerrit's
    Rebase button. It needs no worktree: each commit is merged onto the new
    parent with git merge-tree. Every change gets a new patch set with its
    review, and the stack moves. The local branches stay, the author's
    plustwo pull brings the new commits.

    On a conflict nothing changes. The top change gets a rebase request
    instead, for the author to rebase locally and upload. Returns the new
    patch sets [(change, number, kind)], or None after a conflict.
    """
    with review_lock(repository):
        base = base_branch(repository)
        top = git('rev-parse', '--verify', '--quiet', stack_ref(topic), check=False,
                  repository=repository)
        if not top:
            raise ChangeError(f'no stack called {topic}')
        if is_ancestor(base, top, repository):
            raise ChangeError(f'{topic} is on {base} already')
        commits = stack_commits(topic, repository)
        parent = git('rev-parse', base, repository=repository)
        rebased = []
        for commit in commits:
            merge = subprocess.run([*git_command(repository),
                                    'merge-tree', '--write-tree', f'--merge-base={commit}^',
                                    parent, commit], capture_output=True, text=True)
            if 0 != merge.returncode:
                note = read_note(top, repository)
                note['rebase_requested'] = True
                write_note(top, note, repository)
                return None
            (name, email, date), message = raw_commit(commit, repository)
            environment = dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
                               GIT_AUTHOR_DATE=date)
            parent = subprocess.run(
                [*git_command(repository), 'commit-tree',
                 merge.stdout.split('\n')[0], '-p', parent, '-F', '-'],
                input=message, capture_output=True, text=True, env=environment,
                check=True).stdout.strip()
            rebased.append((commit, parent))

        uploaded = []
        for old, new in rebased:
            change = change_from(new, topic, read_note(old, repository), repository)
            change.rebase_requested = False
            number, kind = add_patch_set(change, repository)
            change.rebased_patch_set = number
            write_note(new, note_of(change), repository)
            uploaded.append((change, number, kind))
        git('update-ref', stack_ref(topic), parent, top, repository=repository)
        return uploaded


# ── built-in checks ───────────────────────────────────────────────────────

CHECK_LOG_LINES = 20


def git_path(name, repository=None):
    """An absolute path inside the repository's .git directory."""
    repository = current_repository(repository)
    path = Path(git('rev-parse', '--git-path', name, repository=repository))
    return path if path.is_absolute() else (Path(repository or '.') / path).absolute()


def cancel_check(repository=None):
    """Stops a running check of the repository, if there is one."""
    pid_file = git_path('plustwo/check.pid', repository)
    if not pid_file.exists():
        return
    with contextlib.suppress(ValueError, ProcessLookupError, PermissionError):
        os.killpg(int(pid_file.read_text().split()[0]), signal.SIGTERM)
    pid_file.unlink(missing_ok=True)


def start_check(topic, repository=None):
    """Starts the check (setting checks.command) of a stack's top change in
    the background, after stopping one still running: a newer upload makes
    its result useless. Returns whether a check started.
    """
    if not setting('checks.command', repository=repository):
        return False
    cancel_check(repository)
    top = git('rev-parse', stack_ref(topic), repository=repository)
    root = toplevel(repository)
    process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'check-run',
                                topic, top], cwd=root, start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
    pid_file = git_path('plustwo/check.pid', repository)
    pid_file.parent.mkdir(parents=True, exist_ok=True)
    pid_file.write_text(f'{process.pid} {top}\n')
    return True


def run_check(topic, commit=None, repository=None):
    """Runs the check of a stack's top change (or commit) in the worktree
    .git/plustwo/check, setting checks.setup first if there is one, and
    votes Verified by ci with the end of the log. The log stays in
    .git/plustwo/check.log. Returns the vote, None without checks.command.
    """
    command = setting('checks.command', repository=repository)
    if not command:
        return None
    commit = commit or git('rev-parse', stack_ref(topic), repository=repository)
    worktree = git_path('plustwo/check', repository)
    if not (worktree / '.git').exists():
        git('worktree', 'prune', repository=repository)
        git('worktree', 'add', '--detach', '--force', str(worktree), commit,
            repository=repository)
    else:
        git('checkout', '--quiet', '--detach', '--force', commit, repository=str(worktree))
    log_path = git_path('plustwo/check.log', repository)
    with open(log_path, 'w') as log:
        status = 0
        for step in filter(None, (setting('checks.setup', repository=repository), command)):
            log.write(f'$ {step}\n')
            log.flush()
            status = subprocess.run(step, shell=True, cwd=worktree, stdout=log,
                                    stderr=subprocess.STDOUT).returncode
            if status:
                break
    value = 1 if 0 == status else -1
    tail = '\n'.join(log_path.read_text(errors='replace').rstrip('\n').split('\n')
                     [-CHECK_LOG_LINES:])
    change = next((change for change in changes_in_stack(repository)
                   if change.topic == topic and commit in change.patch_sets.values()), None)
    if change is not None:
        number = next(number for number, other in change.patch_sets.items() if other == commit)
        set_vote(change.change_id, VERIFIED, value, by='ci', patch_set=number, message=tail,
                 repository=repository)
    return value


def pull(repository=None):
    """Brings what the reviewer did into the checked out branch: a rebase,
    a submit. Like a fetch and rebase from Gerrit. Returns what happened,
    as a short line.

    The branch's commits that are patch sets are the uploaded ones. Without
    newer local commits, the branch moves to the uploaded stack, or to the
    base branch when all was submitted. Newer local commits are rebased
    onto it, which stops like any rebase on a conflict. Needs a clean
    worktree. The branch is never deleted.
    """
    branch = current_branch(repository)
    base = base_branch(repository)
    if branch is None:
        raise ChangeError('HEAD is detached, check out the branch to pull into')
    if base == branch:
        raise ChangeError(f'{base} is the base branch, check out the branch to pull into')
    if git('status', '--porcelain', '--untracked-files=no', repository=repository):
        raise ChangeError('the worktree has changes, commit or stash them first')
    ensure_layout(repository)
    topic = topic_of_branch(branch)
    server = git('rev-parse', '--verify', '--quiet', stack_ref(topic), check=False,
                 repository=repository)
    target = server or git('rev-parse', base, repository=repository)
    local = commits_between(base, 'HEAD', repository)
    uploaded = []
    for commit in local:
        change_id = change_id_of(commit, repository)
        if not change_id or commit not in patch_sets_of(change_id, repository).values():
            break
        uploaded.append(commit)
    newer = local[len(uploaded):]
    head = git('rev-parse', 'HEAD', repository=repository)
    if not local and head == target:
        return f'{branch} has nothing beyond {base}' + ('' if server else ', all is submitted')
    if head == target or (uploaded and uploaded[-1] == target):
        return f'{branch} is up to date'
    if not newer:
        git('reset', '--quiet', '--keep', target, repository=repository)
        return (f'{branch} moved to the reviewed stack {topic}' if server
                else f'{topic} is submitted, {branch} has nothing beyond {base} now')
    upstream = uploaded[-1] if uploaded else git('merge-base', base, 'HEAD',
                                                 repository=repository)
    result = subprocess.run([*git_command(repository), 'rebase',
                             '--quiet', '--onto', target, upstream, branch],
                            capture_output=True, text=True)
    if 0 != result.returncode:
        return (f'conflict while moving {len(newer)} local commit(s) onto {topic}: resolve, '
                'then git rebase --continue')
    return f'{len(newer)} local commit(s) moved onto ' + (topic if server else base)


def status_name(name):
    """The status a name stands for: unresolved or resolved, or one of the
    older names open, agreed (unresolved), dropped, done (resolved).
    """
    status = name if name in STATUSES else OLD_STATUSES.get(name)
    if status is None:
        raise ChangeError(f'unknown status "{name}", use {UNRESOLVED} or {RESOLVED}')
    return status


def add_comment(change_id, place, text, sent=True, side=NEW_SIDE, author=REVIEWER,
                status=UNRESOLVED, repository=None, patch_set=None):
    """Starts a thread on a patch set, the newest without one, unresolved
    like in Gerrit unless status says otherwise. Returns its number. The
    author's threads are always sent. comment_place() gives place, side
    and patch set for a line of a diff.
    """
    status = status_name(status)

    def edit(change):
        sent_now = sent or AUTHOR == author
        comment = Comment(number=max((other.number for other in change.comments), default=0) + 1,
                          place=place,
                          patch_set=patch_set or change.latest_patch_set(),
                          messages=[Message(author=author, text=text, sent=sent_now,
                                            unresolved=UNRESOLVED == status,
                                            time=int(time.time()) if sent_now else 0)],
                          side=side,
                          id=os.urandom(6).hex())
        change.comments.append(comment)
        return comment.number

    return update_change(change_id, edit, repository)


def add_message(change_id, number, author, text, sent=True, status=None, repository=None):
    """Adds a message to a thread. An author's message is always sent.
    status resolves the thread or makes it unresolved again, None leaves
    it as it is. Like Gerrit's Reply, a reviewer has one draft per thread.
    """
    unresolved = None if status is None else UNRESOLVED == status_name(status)

    def edit(change):
        comment = comment_of(change, number)
        if AUTHOR != author and not sent and comment.has_draft():
            raise ChangeError(f'comment {number} has a draft already, edit that one')
        sent_now = sent or AUTHOR == author
        comment.messages.append(Message(author=author, text=text, sent=sent_now,
                                        time=int(time.time()) if sent_now else 0,
                                        unresolved=unresolved))

    update_change(change_id, edit, repository)


# A line of `plustwo answer`: Change-Id prefix, thread, optional verb, text
ANSWER_PATTERN = re.compile(
    r'^\s*(?:\S+\s+)?(I[0-9a-f]+)\s+#(\d+)\s*(?:\(PS\d+[^)]*\)\s*)?'
    r'(resolve|unresolve|done)?\s*:?\s*(.*)$')


def parse_answers(text):
    """The author's answers, each starting on a line like "I3f2a #2 done",
    "I3f2a #3: text", "I3f2a #4 resolve: text" or "unresolve: text". A
    repository name before the Change-Id and a patch set note after the
    number, as inbox prints them, are allowed. The lines up to the next
    such line continue the answer's text, so it can have lists and
    paragraphs. Returns [(Change-Id prefix, number, status or None, text)].
    Raises one error naming every bad line.
    """
    return [answer[1:] for answer in _parsed_answers(text)]


def _parsed_answers(text):
    """parse_answers() with the line number of each answer first."""
    answers, errors = [], []
    for number, line in enumerate(text.split('\n'), start=1):
        match = ANSWER_PATTERN.match(line)
        if match is not None:
            prefix, thread, verb, message = match.groups()
            answers.append([number, prefix, int(thread), verb, [message.strip()]])
        elif answers:
            # The answer goes on, as written
            answers[-1][4].append(line.rstrip())
        elif line.strip() and not line.lstrip().startswith('#'):
            errors.append(f'line {number} is no answer: {line.strip()}')
    result = []
    for number, prefix, thread, verb, lines in answers:
        status = {'resolve': RESOLVED, 'done': RESOLVED, 'unresolve': UNRESOLVED}.get(verb)
        message = '\n'.join(lines).strip() or (DONE if 'done' == verb else '')
        if not message and status is None:
            errors.append(f'line {number} has no text')
        result.append((number, prefix, thread, status, message))
    if errors:
        raise ChangeError('; '.join(errors))
    return result


def answer(text, repository=None):
    """Adds the author's answers of parse_answers() to their threads, with
    one lock and one note write per change. Checks the format and the
    changes of all lines before writing. Returns the number of answers.
    """
    answers = _parsed_answers(text)
    by_change, errors = {}, []
    for line, prefix, number, status, message in answers:
        # An unknown change or thread stops the whole batch before anything
        # is written. All of them are named, so one retry is enough.
        try:
            change = find_change(prefix, repository)
            comment_of(change, number)
        except ChangeError as error:
            errors.append(f'line {line}: {error}')
            continue
        by_change.setdefault(change.change_id, []).append((number, status, message))
    if errors:
        raise ChangeError('; '.join(errors))
    for change_id, entries in by_change.items():
        def edit(change, entries=entries):
            for number, status, message in entries:
                comment_of(change, number).messages.append(Message(
                    author=AUTHOR, text=message, sent=True, time=int(time.time()),
                    unresolved=None if status is None else UNRESOLVED == status))
        update_change(change_id, edit, repository)
    return len(answers)


def edit_draft(change_id, number, text, repository=None):
    """Replaces the text of the reviewer's draft at the end of a thread."""
    def edit(change):
        comment = comment_of(change, number)
        if not comment.has_draft():
            raise ChangeError(f'comment {number} has no draft')
        comment.messages[-1].text = text

    update_change(change_id, edit, repository)


def delete_draft(change_id, number, repository=None):
    """Deletes the reviewer's draft at the end of a thread.

    A thread that was only a draft disappears completely. The other
    threads keep their numbers.
    """
    def edit(change):
        comment = comment_of(change, number)
        if not comment.has_draft():
            raise ChangeError(f'comment {number} has no draft')
        comment.messages.pop()
        if not comment.messages:
            change.comments.remove(comment)

    update_change(change_id, edit, repository)


def send_drafts(change_id, message='', repository=None):
    """Sends all of the reviewer's drafts of a change, like Gerrit's Reply.
    message, if given, becomes a comment on the whole change, resolved like
    a note. Returns the number of drafts sent.
    """
    def edit(change):
        now = int(time.time())
        drafts = [draft for comment in change.comments for draft in comment.messages
                  if not draft.sent]
        for draft in drafts:
            draft.sent = True
            draft.time = now
        if message:
            change.comments.append(Comment(
                number=max((other.number for other in change.comments), default=0) + 1,
                place=PATCHSET_LEVEL, patch_set=change.latest_patch_set(),
                messages=[Message(author=REVIEWER, text=message, unresolved=False, time=now)],
                id=os.urandom(6).hex()))
        return len(drafts)

    return update_change(change_id, edit, repository)


def set_status(change_id, number, status, text='', repository=None):
    """The author resolves a thread or makes it unresolved again, with a
    message (text may be empty).
    """
    add_message(change_id, number, AUTHOR, text or '', status=status, repository=repository)


def toggle_draft_status(change_id, number, repository=None):
    """The reviewer's Resolved checkbox: flips whether sending the thread's
    draft resolves it. Without a draft, an empty one is made that flips
    the thread's status. Returns the status the draft will give.
    """
    def edit(change):
        comment = comment_of(change, number)
        if not comment.has_draft():
            comment.messages.append(Message(author=REVIEWER, text='', sent=False,
                                            unresolved=not comment.is_unresolved()))
        else:
            draft = comment.messages[-1]
            now = comment.is_unresolved() if draft.unresolved is None else draft.unresolved
            draft.unresolved = not now
        return comment.draft_status()

    return update_change(change_id, edit, repository)


@functools.lru_cache(maxsize=4096)
def file_diff_hash(commit, path, repository=None):
    """A hash of a file's own diff in a commit, against the commit's parent.
    It stays the same while the file's change does, also after a rebase.
    """
    if COMMIT_MSG == path:
        text = git('log', '-1', '--format=%B', commit, repository=repository)
    else:
        text = git('diff', '--no-color', '--no-ext-diff', '--no-textconv', '-U0', f'{commit}^',
                   commit, '--', path, check=False, repository=repository)
        # Line numbers move with a rebase, the edits themselves don't.
        text = '\n'.join(line for line in text.split('\n') if not line.startswith('@@'))
    return hashlib.sha1(text.encode()).hexdigest()[:16]


def is_reviewed(change, path, repository=None):
    """Whether the reviewer marked the file reviewed and its diff is the same
    as then.
    """
    mark = change.reviewed.get(path)
    return bool(mark) and mark == file_diff_hash(change.commit, path, repository)


def toggle_reviewed(change_id, path, repository=None):
    """Marks a file of the change reviewed, or unmarks it. Returns whether
    it is marked now.
    """
    def edit(change):
        if is_reviewed(change, path, repository):
            del change.reviewed[path]
            return False
        change.reviewed[path] = file_diff_hash(change.commit, path, repository)
        return True

    return update_change(change_id, edit, repository)


def label_name(label):
    """The label a name like cr, Code-Review or v stands for."""
    name = LABEL_ALIASES.get(label.lower())
    if name is None:
        raise ChangeError(f'unknown label "{label}", use {CODE_REVIEW} or {VERIFIED}')
    return name


def set_vote(change_id, label, value, by=None, patch_set=None, message='', repository=None):
    """Votes on the latest patch set, or on patch set patch_set. It replaces
    the voter's earlier votes of that label, 0 only removes them. Returns
    the patch set's number.
    """
    label = label_name(label)
    by = by or DEFAULT_VOTERS[label]
    low, high = LABEL_RANGES[label]
    if not low <= value <= high:
        raise ChangeError(f'{label} goes from {low:+d} to {high:+d}')

    def edit(change):
        number = patch_set or change.latest_patch_set()
        if not number:
            raise ChangeError(f'{change.short_id()} has no patch set yet, upload it first')
        if number not in change.patch_sets:
            raise ChangeError(f'{change.short_id()} has no patch set {number}')
        # A vote on an older patch set, e.g. from a slow check, leaves the
        # vote on a newer one alone.
        change.votes = [vote for vote in change.votes
                        if not (label == vote.label and by == vote.by
                                and vote.patch_set <= number)]
        if value:
            change.votes.append(Vote(label=label, value=value, by=by, patch_set=number,
                                     time=int(time.time()),
                                     message=message))
        return number

    return update_change(change_id, edit, repository)


def quick_approve(change_id, send=False, repository=None):
    """Code-Review+2 on the latest patch set, like Gerrit's Quick approve.
    With send, the reviewer's drafts are sent along. Returns (patch set,
    number of drafts sent).
    """
    sent = send_drafts(change_id, repository=repository) if send else 0
    return set_vote(change_id, CODE_REVIEW, 2, repository=repository), sent


def require_verified(change_id, required, repository=None):
    """Sets whether the change needs Verified+1 to be submitted."""
    def edit(change):
        change.verified_required = required

    update_change(change_id, edit, repository)


def versions_to_compare(change, first=None, second=None):
    """The two versions a diff compares, as (label, commit) pairs.

    Without patch sets given: the latest patch set against the current
    commit if it changed since, else the last two patch sets, else the only
    patch set against its parent ("base").
    first can be "base" too: the parent of the second version, which shows
    the whole change as of that version. Either can be "latest".
    """
    latest = change.latest_patch_set()
    first, second = (
        (str(latest) if latest else CURRENT) if LATEST == version else version
        for version in (first, second))

    def commit_of(version):
        if CURRENT == version:
            return change.commit
        if int(version) not in change.patch_sets:
            raise ChangeError(f'{change.short_id()} has no patch set {version}')
        return change.patch_sets[int(version)]

    if first is None:
        if 0 == latest:
            return (BASE, f'{change.commit}^'), (CURRENT, change.commit)
        if change.is_uploaded():
            if latest < 2:
                return (BASE, f'{change.commit}^'), (str(latest), change.commit)
            first, second = str(latest - 1), str(latest)
        else:
            first, second = str(latest), CURRENT
    elif second is None:
        second = CURRENT
    if BASE == second:
        raise ChangeError('base can only be the first of the two versions')
    if BASE == first:
        # The second version's own parent, so a rebase between patch sets
        # doesn't bring other commits into the diff
        new = commit_of(second)
        return (BASE, f'{new}^'), (second, new)
    return (first, commit_of(first)), (second, commit_of(second))


def diff_endpoints(change, first=None, second=None, path=None, repository=None):
    """What git diff compares for two versions of a change: (old, new,
    paths).

    path limits the diff to one file. Without it, the diff covers the files
    the change touches in either version. For /COMMIT_MSG, old and new are
    trees holding the two commit messages. Base has no commit message.
    """
    (first, old), (_second, new) = versions_to_compare(change, first, second)
    if COMMIT_MSG == path:
        return (commit_message_tree(None if BASE == first else old, repository),
                commit_message_tree(new, repository), [COMMIT_MSG_NAME])
    if path:
        return old, new, [path]
    files = set(files_of(new, repository))
    if BASE != first:
        files |= set(files_of(old, repository))
    return old, new, sorted(files)


def diff_command(change, first=None, second=None, tool=False, path=None):
    """The git command showing the diff between two versions of a change."""
    old, new, files = diff_endpoints(change, first, second, path)
    command = ['difftool', '-y'] if tool else ['diff']
    return ['git', *command, old, new, '--', *files]


# Gerrit's whitespace modes and the git diff options for them
WHITESPACE_OPTIONS = {'none': (), 'trailing': ('--ignore-space-at-eol',),
                      'changed': ('--ignore-space-change',), 'all': ('--ignore-all-space',)}
WHITESPACE_MODES = tuple(WHITESPACE_OPTIONS)


@cached_for_objects(0, 1)
def edits_of(old, new, path, repository=None, old_path=None, whitespace='none'):
    """The edits of a file's diff: [(old begin, old end, new begin, new
    end)], line ranges counted from 1, the end not included. An insertion
    has an empty old range, a deletion an empty new range. old_path is the
    file's path in old if it was renamed. whitespace is one of Gerrit's
    modes, see WHITESPACE_OPTIONS.
    """
    # Histogram is the algorithm of JGit, so the edits are the ones Gerrit
    # shows. The options make the user's diff settings not count.
    options = ('--no-color', '--no-ext-diff', '--no-textconv', '--no-renames', '--histogram',
               '-U0', *WHITESPACE_OPTIONS.get(whitespace, ()))
    output = '' if old_path else git('diff', *options, old, new, '--', path,
                                     repository=repository)
    if old_path or output.count('diff --git ') > 1:
        # A file that became a symbolic link or the other way round is a
        # deletion and an addition to git. Its lines are diffed as blobs.
        # A renamed file is diffed the same way.
        blobs = [git('rev-parse', '--verify', '--quiet', f'{version}:{version_path}',
                     check=False, repository=repository)
                 or git('hash-object', '-w', '--stdin', input_text='', repository=repository)
                 for version, version_path in ((old, old_path or path), (new, path))]
        output = git('diff', *options, *blobs, repository=repository)
    edits = []
    for match in re.finditer(r'^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@', output, re.MULTILINE):
        old_start, old_count, new_start, new_count = (
            int(value) if value is not None else 1 for value in match.groups())
        # An empty range is given by the line before it.
        old_begin = old_start if old_count else old_start + 1
        new_begin = new_start if new_count else new_start + 1
        edits.append((old_begin, old_begin + old_count, new_begin, new_begin + new_count))
    return edits


# Kinds of the halves of a side by side row
CONTEXT = 'context'
REMOVED = 'removed'
ADDED = 'added'
EMPTY = 'empty'
# Intraline edits are only shown for line pairs at least this similar,
# else the whole line counts as changed, like in Gerrit
INTRALINE_MIN_RATIO = 0.5


@dataclass
class Half:
    """One side of a side by side row: a line of one version of the file,
    or nothing (EMPTY, number None) where the other side has more lines.
    edits are the (begin, end) character ranges an intraline diff found.
    """
    kind: str
    number: int | None = None
    text: str = ''
    edits: list[tuple[int, int]] = field(default_factory=list)
    # A removed line that comes back elsewhere, or an added one that was
    # elsewhere, see moved_lines()
    moved: bool = False
    # A removed or added line that is new text all over: without a
    # partner, or too different from it for intraline edits. The
    # interfaces give it the strong shade, a paired line only on its edits.
    whole: bool = False


@dataclass
class Row:
    """A row of a side by side diff: two halves, or a gap of common lines
    left out (skipped > 0, the halves give the first line of the gap).
    """
    old: Half
    new: Half
    skipped: int = 0


@cached_for_objects(0)
def file_lines(version, path, repository=None):
    """The lines of a file in a commit or tree, without line ends. Empty if
    the file isn't there. None for a binary file. Bytes that aren't UTF-8
    become replacement characters, so every file can be shown.
    """
    command = [*git_command(repository), 'cat-file', 'blob',
               f'{version}:{path}']
    result = subprocess.run(command, capture_output=True)
    if 0 != result.returncode:
        # A submodule is a commit, which git diffs as one line like this
        entry = git('ls-tree', version, '--', path, check=False, repository=repository).split()
        if entry and '160000' == entry[0]:
            return [f'Subproject commit {entry[2]}']
        return []
    if b'\0' in result.stdout[:8000]:
        return None
    text = result.stdout.decode('utf-8', errors='replace')
    return text.split('\n')[:-1] if text.endswith('\n') else text.split('\n') if text else []


# An SGR escape sequence (colours and styles) in a highlighter's output
SGR_PATTERN = re.compile(r'\x1b\[([0-9;]*)m|\x1b\[[0-9;]*[A-Za-z]')
SGR_STYLES = {1: 'bold', 3: 'italic', 4: 'underline'}
SGR_RESETS = {22: 'bold', 23: 'italic', 24: 'underline'}
# xterm's 16 basic colours, for highlighters that use them
BASIC_HEX = ('#000000', '#cd0000', '#00cd00', '#cdcd00', '#0000ee', '#cd00cd', '#00cdcd',
             '#e5e5e5', '#7f7f7f', '#ff0000', '#00ff00', '#ffff00', '#5c5cff', '#ff00ff',
             '#00ffff', '#ffffff')


def palette_hex(index):
    """The colour of an entry of the 256 colour palette, as #rrggbb."""
    if index < 16:
        return BASIC_HEX[index]
    if index >= 232:
        grey = 8 + 10 * (index - 232)
        return f'#{grey:02x}{grey:02x}{grey:02x}'
    levels = (0, 95, 135, 175, 215, 255)
    index -= 16
    return '#' + ''.join(f'{levels[value]:02x}' for value in
                         (index // 36, index // 6 % 6, index % 6))


def sgr_segments(line):
    """Splits a line of terminal output into (text, colour, styles) parts:
    colour as #rrggbb or None for the default, styles a tuple of bold,
    italic and underline.
    """
    segments = []
    colour, styles = None, set()
    position = 0
    for match in SGR_PATTERN.finditer(line):
        if match.start() > position:
            segments.append((line[position:match.start()], colour, tuple(sorted(styles))))
        position = match.end()
        if match.group(1) is None:
            continue
        codes = [int(code) if code else 0 for code in match.group(1).split(';')]
        index = 0
        while index < len(codes):
            code = codes[index]
            index += 1
            if 0 == code:
                colour, styles = None, set()
            elif code in SGR_STYLES:
                styles.add(SGR_STYLES[code])
            elif code in SGR_RESETS:
                styles.discard(SGR_RESETS[code])
            elif 30 <= code <= 37 or 90 <= code <= 97:
                colour = BASIC_HEX[code - 30 if code < 90 else code - 82]
            elif 39 == code:
                colour = None
            elif code in (38, 48) and index < len(codes):
                if 5 == codes[index] and index + 1 < len(codes):
                    value, index = palette_hex(codes[index + 1]), index + 2
                elif 2 == codes[index] and index + 3 < len(codes):
                    value = '#' + ''.join(f'{part:02x}' for part in codes[index + 1:index + 4])
                    index += 4
                else:
                    value, index = None, len(codes)
                if 38 == code:
                    colour = value
    if position < len(line):
        segments.append((line[position:], colour, tuple(sorted(styles))))
    return segments


def highlighter():
    """The program that colours source code: bat (batcat on Debian), None
    without it.
    """
    return shutil.which('bat') or shutil.which('batcat')


def syntax_segments(lines, path, theme=None):
    """Syntax colours of a file's lines, from bat: for each line a list of
    (text, colour, styles), see sgr_segments(). None without bat, or if
    its output doesn't fit the lines. Both interfaces draw these. theme is
    a bat theme, None for bat's own choice. Kept by the text, so the same
    file isn't coloured twice.
    """
    if not lines:
        return None
    return _syntax_segments(tuple(lines), path, theme)


@functools.lru_cache(maxsize=64)
def _syntax_segments(lines, path, theme):
    """syntax_segments() of lines as a tuple."""
    program = highlighter()
    if not program:
        return None
    result = subprocess.run([program, '--color=always', '--style=plain', '--paging=never',
                             '--wrap=never', f'--file-name={path}',
                             *([f'--theme={theme}'] if theme else [])],
                            input='\n'.join(lines) + '\n', capture_output=True, text=True,
                            errors='replace', env={**os.environ, 'COLORTERM': 'truecolor'})
    output = result.stdout.split('\n')
    if 0 != result.returncode or len(output) < len(lines):
        return None
    highlighted = []
    for line, rendered in zip(lines, output):
        segments = sgr_segments(rendered)
        if ''.join(segment[0] for segment in segments) != line:
            return None
        highlighted.append(segments)
    return highlighted


# Intraline edits this few characters apart become one, like in Gerrit
INTRALINE_COALESCE = 5


def is_word_character(character):
    """Whether a character belongs to a word or name, like in \\w."""
    return character.isalnum() or '_' == character


def widened(begin, end, text):
    """A character range grown to the words it cuts into."""
    while 0 < begin < len(text) and is_word_character(text[begin - 1]) \
            and is_word_character(text[begin]):
        begin -= 1
    while 0 < end < len(text) and is_word_character(text[end - 1]) \
            and is_word_character(text[end]):
        end += 1
    return begin, end


def merged_ranges(ranges):
    """Ranges in order with overlapping or touching ones joined."""
    result = []
    for begin, end in sorted(ranges):
        if result and begin <= result[-1][1]:
            result[-1] = (result[-1][0], max(end, result[-1][1]))
        else:
            result.append((begin, end))
    return result


def whitespace_spans(text, whitespace):
    """A line as the whitespace mode compares it: (text, spans), spans
    giving each compared character's (begin, end) in the line. trailing
    drops the whitespace at the end, changed also makes each run of
    whitespace one space, all drops every whitespace.
    """
    spans = []
    compared = []
    end = len(text.rstrip()) if whitespace in ('trailing', 'changed', 'all') else len(text)
    index = 0
    while index < end:
        if text[index].isspace() and whitespace in ('changed', 'all'):
            run = index
            while run < end and text[run].isspace():
                run += 1
            if 'changed' == whitespace:
                compared.append(' ')
                spans.append((index, run))
            index = run
            continue
        compared.append(text[index])
        spans.append((index, index + 1))
        index += 1
    return ''.join(compared), spans


def intraline_edits(old, new, whitespace='none'):
    """The character ranges that differ between two lines, for each line,
    or two empty lists when the lines are too different to compare.
    See intraline_pair().
    """
    pair = intraline_pair(old, new, whitespace)
    return pair if pair is not None else ([], [])


def intraline_pair(old, new, whitespace='none'):
    """The character ranges that differ between two lines, for each line,
    or None when the lines are too different to compare.
    whitespace is one of WHITESPACE_MODES: whitespace that mode ignores
    isn't marked either. Gerrit's intraline diff doesn't look at the mode,
    here it follows it, so ignoring whitespace hides it everywhere.

    Like Gerrit's IntraLineLoader: a diff of the characters, whose edits
    are joined when at most INTRALINE_COALESCE characters lie between them,
    so a few equal characters don't split a change into pieces. Gerrit
    stops there. Here an edit also grows to the whole words it cuts into,
    so a changed name is marked whole, not as scattered letters.
    """
    (old_compared, old_spans), (new_compared, new_spans) = (
        whitespace_spans(old, whitespace), whitespace_spans(new, whitespace))
    matcher = difflib.SequenceMatcher(None, old_compared, new_compared, autojunk=False)
    if matcher.ratio() < INTRALINE_MIN_RATIO:
        return None

    def in_line(begin, end, spans):
        # A range of compared characters as one of the line
        return spans[begin][0], spans[end - 1][1]

    edits = []
    for tag, old_begin, old_end, new_begin, new_end in matcher.get_opcodes():
        if 'equal' == tag:
            continue
        if edits and (old_begin - edits[-1][1] <= INTRALINE_COALESCE
                      or new_begin - edits[-1][3] <= INTRALINE_COALESCE):
            edits[-1] = (edits[-1][0], old_end, edits[-1][2], new_end)
        else:
            edits.append((old_begin, old_end, new_begin, new_end))
    old_edits = merged_ranges(widened(*in_line(begin, end, old_spans), old)
                              for begin, end, _, _ in edits if end > begin)
    new_edits = merged_ranges(widened(*in_line(begin, end, new_spans), new)
                              for _, _, begin, end in edits if end > begin)
    return old_edits, new_edits


# A block of lines counts as moved with at least this many letters and
# digits, like git diff --color-moved
MOVED_MIN_ALNUM = 20


def moved_lines(old_lines, new_lines, edits):
    """The lines of a file's diff that moved: (old line numbers, new line
    numbers), like git diff --color-moved. A block of removed lines that
    comes back the same as a block of added lines elsewhere is moved, if
    it has at least MOVED_MIN_ALNUM letters and digits, so single braces
    or blank lines don't count. Unlike git, only within the file.
    """
    removed = {line for edit in edits for line in range(edit[0], edit[1])}
    added = {line for edit in edits for line in range(edit[2], edit[3])}
    by_text = {}
    for line in sorted(added):
        by_text.setdefault(new_lines[line - 1], []).append(line)
    old_moved, new_moved = set(), set()
    for line in sorted(removed):
        if line in old_moved:
            continue
        best = []
        for start in by_text.get(old_lines[line - 1], []):
            length = 0
            while (line + length in removed and start + length in added
                   and old_lines[line + length - 1] == new_lines[start + length - 1]):
                length += 1
            if length > len(best):
                best = [(line + offset, start + offset) for offset in range(length)]
        if sum(character.isalnum() for old, _ in best for character in old_lines[old - 1]) \
                >= MOVED_MIN_ALNUM:
            old_moved.update(old for old, _ in best)
            new_moved.update(new for _, new in best)
    return old_moved, new_moved


# Edits with more removed times added lines than this pair them by their
# order, the search for similar lines would take too long.
PAIRING_MAX_CELLS = 2500


def line_similarity(old, new):
    """How alike two lines are, 0 to 1, see difflib's ratio()."""
    matcher = difflib.SequenceMatcher(None, old, new, autojunk=False)
    if matcher.real_quick_ratio() < INTRALINE_MIN_RATIO \
            or matcher.quick_ratio() < INTRALINE_MIN_RATIO:
        return 0
    return matcher.ratio()


def paired_lines(removed, added):
    """See _paired_lines(), kept for the same lines."""
    return _paired_lines(tuple(removed), tuple(added))


@functools.lru_cache(maxsize=CACHE_SIZE)
def _paired_lines(removed, added):
    """Pairs the removed and added lines of one edit by similarity, in
    order: [(index into removed or None, index into added or None)].

    The pairs are the ones with the most similarity in all, only lines at
    least INTRALINE_MIN_RATIO alike pair. The others stand alone, the
    removed ones of a run before the added ones. Like delta, unlike
    Gerrit, which pairs by position: then a rewritten block shows
    unrelated lines side by side. Big edits still pair by position.
    """
    if len(removed) * len(added) > PAIRING_MAX_CELLS or not removed or not added:
        return [(index if index < len(removed) else None, index if index < len(added) else None)
                for index in range(max(len(removed), len(added)))]
    similarity = [[line_similarity(old, new) for new in added] for old in removed]
    # best[i][j]: the most similarity of the first i removed and j added lines
    best = [[0.0] * (len(added) + 1) for _ in range(len(removed) + 1)]
    for i in range(1, len(removed) + 1):
        for j in range(1, len(added) + 1):
            best[i][j] = max(best[i - 1][j], best[i][j - 1],
                             best[i - 1][j - 1] + similarity[i - 1][j - 1]
                             if similarity[i - 1][j - 1] else 0)
    pairs = []
    i, j = len(removed), len(added)
    while i and j:
        if similarity[i - 1][j - 1] and best[i][j] == best[i - 1][j - 1] + similarity[i - 1][j - 1]:
            pairs.append((i - 1, j - 1))
            i, j = i - 1, j - 1
        elif best[i][j] == best[i - 1][j]:
            i -= 1
        else:
            j -= 1
    pairs.reverse()
    result = []
    old_at = new_at = 0
    for old, new in pairs + [(len(removed), len(added))]:
        result += [(index, None) for index in range(old_at, old)]
        result += [(None, index) for index in range(new_at, new)]
        if old < len(removed):
            result.append((old, new))
        old_at, new_at = old + 1, new + 1
    return result


def side_by_side_rows(old_lines, new_lines, edits, context=None, whitespace='none'):
    """Lays out two versions of a file side by side, like Gerrit's diff
    view. edits are git's, as edits_of() gives them. Each edit's removed
    and added lines are paired by similarity (see paired_lines()), a line
    without a partner gets an empty half. context is the number of common
    lines kept around each edit, None for the whole file. Longer runs of
    common lines become one gap row. whitespace is the mode of the edits,
    the intraline edits follow it.
    """
    rows = []
    old_moved, new_moved = moved_lines(old_lines, new_lines, edits)

    def common(old_begin, new_begin, count, keep_before, keep_after):
        # Common lines from old_begin and new_begin, counted from 0. Lines
        # beyond keep_before at the start and keep_after at the end form a gap.
        if context is None or count <= keep_before + keep_after:
            keep_before, keep_after = count, 0
        for offset in range(count):
            if keep_before <= offset < count - keep_after:
                if keep_before == offset:
                    rows.append(Row(Half(CONTEXT, old_begin + offset + 1),
                                    Half(CONTEXT, new_begin + offset + 1),
                                    skipped=count - keep_before - keep_after))
                continue
            rows.append(Row(Half(CONTEXT, old_begin + offset + 1, old_lines[old_begin + offset]),
                            Half(CONTEXT, new_begin + offset + 1, new_lines[new_begin + offset])))

    old_at = new_at = 0
    for old_begin, old_end, new_begin, new_end in edits:
        keep = 0 if context is None else context
        common(old_at, new_at, old_begin - 1 - old_at, keep if rows else 0, keep)
        removed = range(old_begin - 1, old_end - 1)
        added = range(new_begin - 1, new_end - 1)
        for old_index, new_index in paired_lines([old_lines[line] for line in removed],
                                                 [new_lines[line] for line in added]):
            old = (Half(REMOVED, removed[old_index] + 1, old_lines[removed[old_index]])
                   if old_index is not None else Half(EMPTY))
            new = (Half(ADDED, added[new_index] + 1, new_lines[added[new_index]])
                   if new_index is not None else Half(EMPTY))
            old.moved, new.moved = old.number in old_moved, new.number in new_moved
            pair = (intraline_pair(old.text, new.text, whitespace)
                    if old.number and new.number else None)
            if pair is not None:
                old.edits, new.edits = pair
            old.whole, new.whole = old.number is not None and pair is None, \
                new.number is not None and pair is None
            rows.append(Row(old, new))
        old_at, new_at = old_end - 1, new_end - 1
    common(old_at, new_at, len(old_lines) - old_at, 0 if context is None else context, 0)
    return rows


def expand_gaps(rows, starts, old_lines, new_lines):
    """The rows with the gaps that start at these old lines opened into
    their common lines.
    """
    result = []
    for row in rows:
        if not row.skipped or row.old.number not in starts:
            result.append(row)
            continue
        for offset in range(row.skipped):
            old, new = row.old.number + offset, row.new.number + offset
            result.append(Row(Half(CONTEXT, old, old_lines[old - 1]),
                              Half(CONTEXT, new, new_lines[new - 1])))
    return result


def old_path_of(change, first, second, path, repository=None):
    """The path of a file in the older of two versions, if the change
    renamed it there and the older version doesn't have it. Else None.
    """
    old, new, _ = diff_endpoints(change, first, second, path, repository)
    if COMMIT_MSG == path or file_lines(old, path, repository) != []:
        return None
    # Renamed by the change: the new version's own rename
    source = renames_of(new, repository).get(path)
    return source if source and file_lines(old, source, repository) else None


def file_diff_rows(change, first=None, second=None, path=None, context=None, repository=None,
                   whitespace='none'):
    """The side by side rows of one file's diff between two versions of a
    change, None if the file is binary. A renamed file is diffed against its
    old path. whitespace is one of WHITESPACE_MODES.
    """
    old, new, paths = diff_endpoints(change, first, second, path, repository)
    old_path = old_path_of(change, first, second, paths[0], repository)
    old_lines = file_lines(old, old_path or paths[0], repository)
    new_lines = file_lines(new, paths[0], repository)
    if old_lines is None or new_lines is None:
        return None
    return side_by_side_rows(old_lines, new_lines,
                             edits_of(old, new, paths[0], repository, old_path, whitespace),
                             context, whitespace)


def ranges_overlap(first_begin, first_end, second_begin, second_end):
    """Whether two line ranges overlap. An empty range is a point between
    lines and overlaps a range it touches.
    """
    if first_begin == first_end:
        return second_begin <= first_begin <= second_end
    if second_begin == second_end:
        return first_begin <= second_begin <= first_end
    return first_begin < second_end and second_begin < first_end


def moved_range(begin, end, edits):
    """Moves a line range of a parent into its child, through the child's
    own edits. Returns (begin, end, exact). exact is False when the range
    overlaps one of the edits: then the result covers the range and those
    edits, since the lines can't be placed more exactly.
    """
    overlapping = [edit for edit in edits if ranges_overlap(begin, end, edit[0], edit[1])]
    low = min([begin] + [edit[0] for edit in overlapping])
    high = max([end] + [edit[1] for edit in overlapping])
    shift = sum(edit[3] - edit[2] - (edit[1] - edit[0]) for edit in edits
                if edit[1] <= low and edit not in overlapping)
    growth = sum(edit[3] - edit[2] - (edit[1] - edit[0]) for edit in overlapping)
    return low + shift, high + shift + growth, not overlapping


def rebase_lines(change, first=None, second=None, path=None, repository=None):
    """Lines of a diff between two patch sets that differ because the
    changes below changed, i.e. the base moved, not only the change itself.
    Returns ((old lines, new lines) from below, (old lines, new lines)
    partly from below).

    It works like Gerrit: the edits between the two parents are moved
    into the patch sets' line numbers, through each patch set's own edits
    against its parent. An edit of the diff that equals one of them comes
    from below. One that only overlaps one, e.g. where a change below and
    the change itself edited the same lines, is partly from below. Unlike
    Gerrit, which leaves those unmarked, they get marked, so no line from
    below goes unnoticed.

    Empty for the whole change against base, the commit message, and when
    the parent stayed the same.
    """
    nothing = ((set(), set()), (set(), set()))
    (first, old), (_second, new) = versions_to_compare(change, first, second)
    if BASE == first or COMMIT_MSG == path or not path:
        return nothing
    if tree_of(f'{old}^', repository) == tree_of(f'{new}^', repository):
        return nothing
    old_own = edits_of(f'{old}^', old, path, repository)
    new_own = edits_of(f'{new}^', new, path, repository)
    moved = []
    for old_begin, old_end, new_begin, new_end in edits_of(f'{old}^', f'{new}^', path, repository):
        begin, end, old_exact = moved_range(old_begin, old_end, old_own)
        other_begin, other_end, new_exact = moved_range(new_begin, new_end, new_own)
        moved.append((begin, end, other_begin, other_end, old_exact and new_exact))

    from_below, partly = (set(), set()), (set(), set())
    for edit in edits_of(old, new, path, repository):
        if any(edit == other[:4] and other[4] for other in moved):
            lines = from_below
        elif any(ranges_overlap(edit[0], edit[1], other[0], other[1])
                 or ranges_overlap(edit[2], edit[3], other[2], other[3]) for other in moved):
            lines = partly
        else:
            continue
        lines[0].update(range(edit[0], edit[1]))
        lines[1].update(range(edit[2], edit[3]))
    return from_below, partly


# ── threads on newer patch sets, like Gerrit's ported comments ────────────

# How a thread's line fared on the way to another patch set
SAME = 'same'
MOVED = 'moved'
EDITED = 'edited'
REMOVED = 'removed'
FILE_GONE = 'file gone'


@dataclass
class PortedPlace:
    """Where a thread of an older patch set is in a newer one.

    place is the thread's place there, line its line (None for a thread
    on a whole file, or when the line or file is gone). state is SAME
    (same line number and text), MOVED (same text, other number or file),
    EDITED (the line was changed, line is the best guess), REMOVED or
    FILE_GONE.
    """
    place: str
    line: int | None
    state: str
    patch_set: int

    def label(self, place):
        """The note for inbox lines, without the patch set: '' when the
        thread is where it was, else like 'now :50' or 'line removed'.
        """
        if self.state in (REMOVED, FILE_GONE):
            return 'line removed' if REMOVED == self.state else 'file gone'
        path, _, line = place.rpartition(':')
        new_path, _, new_line = self.place.rpartition(':')
        if not line.isdigit():
            return '' if self.place == place else f'now {self.place}'
        moved = f'{new_path if new_path != path else ""}:{new_line}'
        if EDITED == self.state:
            return f'edited, now {moved}'
        return '' if self.place == place else f'now {moved}'


@cached_for_objects(0, 1)
def path_in(old, new, path, repository=None):
    """The path a file of commit old has in commit new: the same if new
    has it, else where git's rename detection finds it, None if it is gone.
    """
    if git('rev-parse', '--verify', '--quiet', f'{new}:{path}', check=False,
           repository=repository):
        return path
    fields = git('diff-tree', '-M', '-r', '--name-status', '-z', old, new, '--',
                 repository=repository).split('\0')
    index = 0
    while index < len(fields) and fields[index]:
        if fields[index].startswith(('R', 'C')):
            if fields[index + 1] == path:
                return fields[index + 2]
            index += 3
        else:
            index += 2
    return None


def ported_line(line, edits):
    """Moves a line through the edits of a diff, like Gerrit's
    GitPositionTransformer: lines outside the edits shift by the lines the
    edits before them added or removed. Returns (line, state).
    """
    shift = 0
    for old_begin, old_end, new_begin, new_end in edits:
        if old_begin <= line < old_end:
            if new_begin == new_end:
                return None, REMOVED
            # Gerrit drops the line here and keeps the file. The line at
            # the same offset in the new lines is a better place to show.
            return new_begin + min(line - old_begin, new_end - new_begin - 1), EDITED
        if old_end <= line:
            shift += new_end - new_begin - (old_end - old_begin)
    return line + shift, SAME if 0 == shift else MOVED


@cached_for_objects(0, 1)
def moved_place(source, target, path, line, repository=None):
    """Moves a file's line from one version into another: (path, line,
    state), see ported_line(). source and target are commits, or parents
    like abc^, which never change, so the result is kept. line is None for
    the whole file, also in the result when the line or the file is gone.
    For /COMMIT_MSG, both must be commits.
    """
    if PATCHSET_LEVEL == path:
        return path, None, SAME
    if COMMIT_MSG == path:
        if line is None:
            return path, None, SAME
        edits = edits_of(commit_message_tree(source, repository),
                         commit_message_tree(target, repository), COMMIT_MSG_NAME, repository)
        number, state = ported_line(line, edits)
        return path, number, state
    new_path = path_in(source, target, path, repository)
    if new_path is None:
        return path, None, FILE_GONE
    if line is None:
        return new_path, None, SAME if new_path == path else MOVED
    edits = edits_of(source, target, new_path, repository, path if path != new_path else None)
    number, state = ported_line(line, edits)
    if SAME == state and new_path != path:
        state = MOVED
    return new_path, number, state


def split_place(place):
    """A place as (path, line), line None for a whole file or change."""
    path, _, line = place.rpartition(':')
    return (path, int(line)) if path and line.isdigit() else (place, None)


def join_place(path, line):
    """The place of a path and a line, see split_place()."""
    return path if line is None else f'{path}:{line}'


def thread_version(change, comment, repository=None):
    """The version a thread's place counts in: (version, path there). The
    new side is the thread's patch set, the old side its parent, with the
    file's path there. None when the patch set isn't known.
    """
    origin = change.patch_sets.get(comment.patch_set)
    if origin is None:
        return None
    path, _line = split_place(comment.place)
    if OLD_SIDE != comment.side:
        return origin, path
    if path in (COMMIT_MSG, PATCHSET_LEVEL):
        return f'{origin}^', path
    return f'{origin}^', renames_of(origin, repository).get(path, path)


def port_thread(change, comment, target=None, repository=None):
    """Where a thread of an older patch set is in a newer version, like
    Gerrit's ported comments, as a PortedPlace. target is a patch set
    number, the latest without it. None when the thread is on that patch
    set already, or on a newer one. target can also be CURRENT, the
    change's commit.

    Like Gerrit, a thread moves through one direct diff from its patch set
    to the target, rebases included, and an old side thread through the
    diff of the two parents. Renamed files are followed. Unlike Gerrit,
    which then keeps only the file, a thread on edited lines keeps the line
    at the same offset of the new lines (state EDITED). A thread on a
    removed line keeps its file, the interfaces show it at the top of the
    file. One on a gone file keeps its place here, thread_place() moves it
    to the whole change, like Gerrit.
    """
    target = target or change.latest_patch_set()
    if CURRENT == target:
        commit = change.commit
    elif target in change.patch_sets and comment.patch_set < target:
        commit = change.patch_sets[target]
    else:
        return None
    version = thread_version(change, comment, repository)
    if version is None or change.patch_sets[comment.patch_set] == commit:
        return None
    place, line, state = _place_in(change, comment, version, commit if OLD_SIDE != comment.side
                                   else f'{commit}^', commit, repository)
    return PortedPlace(place, line, state, target)


def _place_in(change, comment, version, target, shown, repository=None):
    """A thread's place moved from its version into target, a version of
    the file as the diff of shown (a commit) names it: (place, line,
    state). For the old side, the path is the one in shown, where the
    interfaces look for it.
    """
    source, source_path = version
    _path, line = split_place(comment.place)
    if COMMIT_MSG == source_path and (source.endswith('^') or target.endswith('^')):
        # Base has no commit message.
        return comment.place, line, SAME if source == target else FILE_GONE
    path, number, state = moved_place(source, target, source_path, line, repository)
    if FILE_GONE != state and target != shown and path not in (COMMIT_MSG, PATCHSET_LEVEL):
        # A file of the left version under its name in the right one
        path = path_in(target, shown, path, repository) or path
    return join_place(path, number), number, state


def comment_place(change, path, line, side, first=None, second=None, repository=None):
    """Where a new thread on a line of the diff of two versions goes:
    (place, side, patch set). path is the file's path in the right version,
    line None for the whole file. Like in Gerrit, a thread in the left pane
    is on the left patch set when that is one, else on the old side of the
    right one. 0 as patch set means the newest.
    """
    (first_label, _left), (second_label, _right) = versions_to_compare(change, first, second)
    patch_set = int(second_label) if second_label.isdigit() else 0
    if OLD_SIDE == side and first_label.isdigit():
        old_path = old_path_of(change, first, second, path, repository) or path
        return join_place(old_path, line), NEW_SIDE, int(first_label)
    return join_place(path, line), side, patch_set


@dataclass
class ShownThread:
    """Where the diff of two versions shows a thread, see thread_place()."""
    path: str
    line: int | None
    side: str
    origin: str = ''
    note: str = ''


def thread_place(change, comment, first=None, second=None, repository=None):
    """Where the diff of two versions shows a thread, as a ShownThread.

    A thread goes into the version a pane shows: a new side one of the
    left version's patch set into the left pane, other new side ones into
    the right pane, old side ones into the left pane. A thread on another
    version than the pane's is moved there, see port_thread(), and its
    origin is like "PS2". path is the file's path in the right version.
    line is None for a thread at the top of the file: one on the whole
    file, or whose line is gone. note says what became of the line, like
    "line removed", else empty.

    Like in Gerrit, a thread on a file the version doesn't have becomes
    one on the whole change (path PATCHSET_LEVEL), its note keeps the old
    place: "file gone: a.txt:30".
    """
    (first_label, left), (_second_label, right) = versions_to_compare(change, first, second)
    path, line = split_place(comment.place)
    version = thread_version(change, comment, repository)
    if version is None:
        return ShownThread(path, line, comment.side)
    if OLD_SIDE == comment.side or first_label == str(comment.patch_set):
        side, target = OLD_SIDE, left
    else:
        side, target = NEW_SIDE, right
    if version[0] == target or PATCHSET_LEVEL == path:
        return ShownThread(path, line, side)
    place, number, state = _place_in(change, comment, version, target, right, repository)
    origin = f'PS{comment.patch_set}'
    if FILE_GONE == state:
        return ShownThread(PATCHSET_LEVEL, None, NEW_SIDE, origin, f'file gone: {comment.place}')
    note = {REMOVED: 'line removed', EDITED: 'line edited'}.get(state, '')
    return ShownThread(split_place(place)[0], number, side, origin, note)

# ── the patch set history ─────────────────────────────────────────────────

@dataclass
class PatchSetEvent:
    """Something that happened on a patch set: a thread started on it
    (THREAD), a reply while it was the newest (REPLY) or a vote on it
    (VOTE). number and place are the thread's, text the first line of the
    message, or the vote like Code-Review+2. status is the thread's now.
    """
    kind: str
    time: int
    author: str
    text: str
    number: int | None = None
    place: str = ''
    status: str = ''
    draft: bool = False

    def is_open(self):
        """Whether the event's thread is still unresolved."""
        return THREAD == self.kind and UNRESOLVED == self.status and not self.draft


THREAD = 'thread'
REPLY = 'reply'
VOTE = 'vote'


@dataclass
class PatchSetEntry:
    """One patch set in a change's history, see patch_set_history()."""
    number: int
    commit: str
    uploaded: int
    uploader: str
    # Its kind against the patch set before, see patch_set_kind(), '-' for
    # the first
    kind: str
    votes: list[Vote]
    events: list[PatchSetEvent]

    def new_threads(self):
        """The threads started on this patch set."""
        return [event for event in self.events if THREAD == event.kind]

    def replies(self):
        """The replies sent while it was the newest patch set."""
        return [event for event in self.events if REPLY == event.kind]

    def open_threads(self):
        """The threads started on it that are still unresolved."""
        return [event for event in self.events if event.is_open()]

    def comments_label(self):
        """Like "3 new (1 open), 1 reply", empty without any."""
        parts = []
        new, open_ = len(self.new_threads()), len(self.open_threads())
        if new:
            parts.append(f'{new} new' + (f' ({open_} open)' if open_ else ''))
        replies = len(self.replies())
        if replies:
            parts.append(f'{replies} repl{"y" if 1 == replies else "ies"}')
        return ', '.join(parts)

    def vote_label(self, label):
        """The vote of a label on it for display, like +2, in parentheses
        when only copied from an earlier one. Empty without a vote. Like
        Gerrit, the lowest counts if negative, else the highest.
        """
        votes = [vote for vote in self.votes if label == vote.label]
        if not votes:
            return ''
        values = [vote.value for vote in votes]
        value = min(values) if min(values) < 0 else max(values)
        text = f'{value:+d}' if value else '0'
        return f'({text})' if all(vote.copied_from for vote in votes) else text


def patch_set_history(change, shown=None, repository=None):
    """The change's patch sets, oldest first, as PatchSetEntry: when and by
    whom each was uploaded, its kind against the one before (computed, so
    older notes work), the votes on it and what happened on it. A thread
    belongs to the patch set it was started on. A reply belongs to the
    patch set that was the newest when it was sent, by the upload times,
    like Gerrit's comments per patch set. Draft replies belong to shown,
    the patch set the reviewer looks at, the newest without one. A draft
    thread belongs to the patch set it is on, like a sent one.
    """
    numbers = sorted(change.patch_sets)
    if not numbers:
        return []
    shown = shown if shown in change.patch_sets else numbers[-1]

    def newest_at(when):
        # The patch set that was the newest at a time, the thread's own for
        # messages of older notes without one
        uploaded = [number for number in numbers if change.uploads.get(number, 0) <= when]
        return uploaded[-1] if uploaded else numbers[0]

    events = {number: [] for number in numbers}
    for comment in change.comments:
        for index, message in enumerate(comment.messages):
            text = message_text(message).split('\n')[0]
            if 0 == index:
                number = (comment.patch_set if comment.patch_set in events
                          else shown if not message.sent else numbers[-1])
                events[number].append(PatchSetEvent(
                    THREAD, message.time, message.author, text, comment.number, comment.place,
                    comment.status, comment.is_draft()))
                continue
            if not message.sent:
                number = shown
            elif message.time:
                number = newest_at(message.time)
            else:
                number = comment.patch_set if comment.patch_set in events else numbers[-1]
            events[number].append(PatchSetEvent(REPLY, message.time, message.author, text,
                                                comment.number, comment.place, comment.status,
                                                not message.sent))
    for vote in change.votes:
        if vote.patch_set in events and not vote.copied_from:
            events[vote.patch_set].append(PatchSetEvent(
                VOTE, vote.time, vote.by, f'{vote.label}{vote.value:+d}'
                + (f': {vote.message.split(chr(10))[0]}' if vote.message else '')))
    history = []
    for index, number in enumerate(numbers):
        commit = change.patch_sets[number]
        kind = (patch_set_kind(change.patch_sets[numbers[index - 1]], commit, repository)
                if index else '-')
        # Drafts have no time yet: they come last.
        ordered = sorted(events[number], key=lambda event: (event.draft, event.time))
        history.append(PatchSetEntry(number, commit, change.uploads.get(number, 0),
                                     change.uploaders.get(number, ''), kind,
                                     [vote for vote in change.votes if number == vote.patch_set],
                                     ordered))
    return history


def range_diff_command(change, first=None, second=None):
    """The git command showing the range-diff between two versions."""
    if BASE in (first, second):
        raise ChangeError('a range-diff needs two patch sets, not base')
    (_first, old), (_second, new) = versions_to_compare(change, first, second)
    # Both sides hold one commit each, which are versions of the same change.
    # The creation factor makes range-diff pair them even after big edits.
    return ['git', 'range-diff', '--creation-factor=100', f'{old}^!', f'{new}^!']


# ── the author's side: inbox and watch ────────────────────────────────────

def repository_name(repository):
    """Name of a repository for short messages: its directory's name."""
    return Path(git('rev-parse', '--show-toplevel', repository=repository)).name


def inbox_lines(repositories, topic=None):
    """What the author has to answer, as short lines.

    Only rebase requests, negative votes and unanswered unresolved threads,
    each thread with the quoted source line, so the author needs nothing
    else to start.
    """
    lines = []
    for repository in repositories:
        name = repository_name(repository)
        for change in changes_in_stack(repository):
            if topic and topic != change.topic:
                continue
            if change.rebase_requested:
                lines.append(f'rebase {name} {change.topic}: conflicts with '
                             f'{base_branch(repository)}, rebase locally and upload')
            for label in LABEL_RANGES:
                for vote in change.current_votes(label):
                    if vote.value < 0:
                        lines.append(f'vote {name} {change.short_id()} {label}{vote.value:+d} '
                                     f'PS{vote.patch_set} by {vote.by}')
                        lines += [f'    {line}' for line in vote.message.split('\n')[-10:]
                                  if vote.message]
            for comment in change.comments:
                # A message on the whole change is resolved, but still news.
                if not comment.is_unanswered() or not (comment.is_unresolved()
                                                       or PATCHSET_LEVEL == comment.place):
                    continue
                commit = change.patch_sets.get(comment.patch_set, change.commit)
                quoted = line_at(commit, comment.place, repository, comment.side)
                lines.append(f'{name} {change.short_id()} #{comment.number} '
                             + patch_set_note(change, comment, repository)
                             + comment.place_label() + (f'  | {quoted}' if quoted else ''))
                sent = [message for message in comment.messages if message.sent]
                lines.append(f'    {message_text(sent[-1])}')
    return lines


def patch_set_note(change, comment, repository=None):
    """'(PS2, now :50) ' for a thread of an older patch set than the latest,
    with where it is now, see port_thread(). Empty for one on the latest.
    """
    ported = port_thread(change, comment, repository=repository)
    if ported is None:
        return ''
    label = ported.label(comment.place)
    return f'(PS{comment.patch_set}' + (f', {label}' if label else '') + ') '


def events_of(repository, topic=None):
    """Everything sent, voted or rebased in a repository, as event keys."""
    events = set()
    changes = [change for change in changes_in_stack(repository)
               if not topic or topic == change.topic]
    for change in changes:
        for comment in change.comments:
            for index, message in enumerate(comment.messages):
                if message.sent and REVIEWER == message.author:
                    events.add(('message', change.change_id, comment.number, index))
        for vote in change.votes:
            # Votes a new patch set kept were reported when they were given.
            if AUTHOR != vote.by and not vote.copied_from:
                events.add(('vote', change.change_id, vote.label, vote.value, vote.patch_set,
                            vote.by))
    # Rebases are told per stack, by its top change
    tops = {change.topic: change for change in changes}
    for topic, top in tops.items():
        if top.rebase_requested:
            events.add(('rebase', topic, top.change_id))
        if top.rebased_patch_set:
            events.add(('rebased', topic, top.change_id, top.rebased_patch_set))
    return events


def stacks_of(repository, topic=None):
    """The changes of each stack: topic -> {Change-Id: commit}."""
    stacks = {}
    for change in changes_in_stack(repository):
        if topic and topic != change.topic:
            continue
        stacks.setdefault(change.topic, {})[change.change_id] = change.commit
    return stacks


def watch(repositories, output=sys.stdout, topic=None):
    """Prints one line per change with new sent messages, one per vote, and
    one per stack that was submitted, rebased or needs a rebase.

    Runs until stopped. It only looks closer when a ref of the review
    changed, and it prints nothing else, so watching costs nothing while
    nothing happens.
    """
    versions = {repository: stack_version(repository) for repository in repositories}
    known = {repository: events_of(repository, topic) for repository in repositories}
    stacks = {repository: stacks_of(repository, topic) for repository in repositories}
    while True:
        time.sleep(WATCH_INTERVAL_SECONDS)
        for repository in repositories:
            version = stack_version(repository)
            if version == versions[repository]:
                continue
            versions[repository] = version
            events = events_of(repository, topic)
            new = events - known[repository]
            known[repository] = events
            name = repository_name(repository)

            def say(line):
                print(line, file=output, flush=True)

            # Changes that left a stack and are on the base branch now
            now = stacks_of(repository, topic)
            base = base_branch(repository)
            for topic, before in stacks[repository].items():
                left = [commit for change_id, commit in before.items()
                        if change_id not in now.get(topic, {})]
                gone = [commit for commit in left if is_ancestor(commit, base, repository)]
                if left and not gone and git('rev-parse', '--verify', '--quiet',
                                             f'{ABANDONED_PREFIX}{topic}', check=False,
                                             repository=repository):
                    say(f'abandoned {name} {topic}')
                if gone:
                    say(f'submitted {name} {topic}: {len(gone)} change'
                        + ('s' if len(gone) > 1 else ''))
            stacks[repository] = now

            new_messages = {}
            for event in sorted(new, key=str):
                if 'message' == event[0]:
                    new_messages[event[1]] = new_messages.get(event[1], 0) + 1
                elif 'vote' == event[0]:
                    _, change_id, label, value, patch_set, by = event
                    say(f'vote {name} {change_id[:8]} {label}{value:+d} PS{patch_set} by {by}')
                else:
                    say(f'{event[0]} {name} {event[1]}')
            for change_id, count in new_messages.items():
                say(f'review {name} {change_id[:8]}: {count} new')


# ── command line ──────────────────────────────────────────────────────────

def message_text(message):
    """A message's text for display. An empty one only changed the status."""
    if message.text:
        return message.text
    return f'({"unresolved" if message.unresolved else "resolved"})'


def comment_counts(change):
    """Thread counts per status for display, like "2 unresolved, 1
    resolved".
    """
    sent = [comment for comment in change.comments if not comment.is_draft()]
    counts = [f'{sum(status == comment.status for comment in sent)} {status}'
              for status in STATUSES if any(status == comment.status for comment in sent)]
    drafts = sum(comment.has_draft() for comment in change.comments)
    if drafts:
        counts.append(f'{drafts} draft' + ('s' if drafts > 1 else ''))
    return ', '.join(counts) or '-'


def vote_label(change, label):
    """A label's summary for display: +2, -1, or empty without votes. A
    required Verified without votes shows as "?".
    """
    value = change.label_value(label)
    if value:
        return f'{value:+d}'
    return '?' if VERIFIED == label and change.verified_required else ''


def version_label(change):
    """Patch set label for display: PS2, PS2+ if changed since, - if none."""
    if not change.latest_patch_set():
        return '-'
    return f'PS{change.latest_patch_set()}' + ('' if change.is_uploaded() else '+')


def print_overview(arguments):
    """Prints the dashboard: the sections with their changes, the repo as a
    column, like Gerrit's. Empty sections say so.
    """
    changes = all_changes(arguments.list)
    folded = folded_sections()
    for section, rows in dashboard(changes):
        print(f'{SECTION_TITLES[section]} ({len(rows)})' + (' [folded]' if section in folded
                                                             else ''))
        if section in folded:
            continue
        if not rows:
            print('     (none)')
        for number, change in rows:
            print(f'{number:>4}  {change.short_id()}  {change.repo:<12.12} {change.topic:<14.14} '
                  f'{change.subject:<40.40}  {vote_label(change, CODE_REVIEW):>2} '
                  f'{vote_label(change, VERIFIED):>2}  {change.turn():<11}  '
                  f'{comment_counts(change)}')


def print_comments(arguments):
    """Prints the threads of a change."""
    change = find_change(arguments.change)
    print(f'{change.short_id()} ({change.state()}): {change.subject}')
    if change.verified_required:
        print('Needs Verified+1.')
    for vote in change.votes:
        stale = '' if vote.patch_set == change.latest_patch_set() else ' (older patch set)'
        copied = f', copied from PS{vote.copied_from}' if vote.copied_from else ''
        print(f'{vote.label}{vote.value:+d} by {vote.by} on PS{vote.patch_set}{copied}{stale}')
        for line in filter(None, vote.message.split('\n')):
            print(f'  {line}')
    if not change.comments:
        print('No comments.')
    for comment in change.comments:
        print(f'\n#{comment.number} [{comment.status}] {comment.place_label()} '
              f'(PS{comment.patch_set})')
        for message in comment.messages:
            draft = ' (draft)' if not message.sent else ''
            print(f'  {message.author}{draft}: {message_text(message)}')


def guide_text():
    """The guide for agents working as the author, AGENTS.md next to the
    script (links resolved, like the interface's module).
    """
    path = Path(__file__).resolve().parent / 'AGENTS.md'
    try:
        return path.read_text()
    except OSError as error:
        raise ChangeError(f'cannot read the guide: {error}') from error


def run_tui(arguments):
    """Starts the terminal user interface."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import plustwo_tui  # pylint: disable=import-outside-toplevel
    plustwo_tui.run(sys.modules[__name__], arguments.list)


def parse_arguments(argv):
    """Parses the command line."""
    parser = argparse.ArgumentParser(prog='plustwo', description=__doc__.split('\n')[0])
    parser.set_defaults(run=run_tui, list=None)
    parser.add_argument('--list', help='the dashboard of this list of repositories')
    commands = parser.add_subparsers()

    def command(name, run, help_text, *arguments):
        """Adds a sub-command. Arguments are names or (name, options)."""
        sub = commands.add_parser(name, help=help_text)
        for argument in arguments:
            if isinstance(argument, tuple):
                sub.add_argument(argument[0], **argument[1])
            else:
                sub.add_argument(argument)
        sub.set_defaults(run=run)
        return sub

    def init_command(_arguments):
        moved = init_repository()
        print('commit-msg hook installed, notes follow amends and rebases')
        print(f'registered as {register_repository(unique=True)}')
        print("agents: add 'run plustwo guide' to your AGENTS.md or CLAUDE.md")
        for line in moved:
            print(f'moved setting {line}')

    def config_command(arguments):
        if arguments.key is None:
            print('\n'.join(list_settings()))
        elif arguments.unset:
            set_setting(arguments.key, None, arguments.user)
        elif arguments.value is None:
            value = setting(arguments.key)
            if value is None:
                raise ChangeError(f'{arguments.key} is not set')
            print(value)
        else:
            set_setting(arguments.key, arguments.value, arguments.user)

    def upload_command(arguments):
        branch = branch_with_change(arguments.change) if arguments.change else None
        wip = True if arguments.wip else False if arguments.ready else None
        uploaded, topic, grown = upload(branch, arguments.topic, wip=wip)
        if start_check(topic):
            print(f'{topic}: check started, it votes Verified')
        if grown:
            print(f'added to stack {topic}')
        if wip is not None:
            print(f'{topic}: ' + ('work in progress' if wip else 'ready for review'))
        for other, number, kind in uploaded:
            kept = [f'{vote.label}{vote.value:+d}' for vote in other.current_votes(CODE_REVIEW)
                    + other.current_votes(VERIFIED)]
            print(f'{other.short_id()}: patch set {number}' + (f', {kind}' if kind else '')
                  + (f', keeps {" ".join(kept)}' if kept else ''))

    def rebase_command(arguments):
        topic = arguments.topic
        if topic is None:
            topic = find_change(arguments.change).topic if arguments.change else None
        if topic is None:
            raise ChangeError('name the stack: --topic TOPIC or a CHANGE of it')
        rebased = rebase_stack(topic)
        print(f'{topic}: rebased, {len(rebased)} new patch set(s)' if rebased is not None
              else f'{topic}: conflicts, the author is asked to rebase')

    def pull_command(_arguments):
        print(pull())

    def check_command(arguments):
        topic = arguments.topic or topic_of_branch(current_branch() or '')
        value = run_check(topic)
        if value is None:
            raise ChangeError('no check set up: plustwo config checks.command "make check"')
        print(f'{topic}: Verified{value:+d}, log in {git_path("plustwo/check.log")}')

    def check_run_command(arguments):
        try:
            run_check(arguments.topic, arguments.commit)
        finally:
            pid_file = git_path('plustwo/check.pid')
            if pid_file.exists() and arguments.commit in pid_file.read_text():
                pid_file.unlink()

    def submit_command(arguments):
        submitted = submit(find_change(arguments.change).change_id)
        print('Submitted: ' + ', '.join(change.short_id() for change in submitted))

    def comment_command(arguments):
        change = find_change(arguments.change)
        number = add_comment(change.change_id, arguments.place, arguments.text,
                             author=AUTHOR if arguments.author else REVIEWER,
                             status=arguments.status)
        print(f'{change.short_id()}: comment #{number} added')

    def reply_command(arguments):
        status = RESOLVED if arguments.resolve else UNRESOLVED if arguments.unresolve else None
        add_message(find_change(arguments.change).change_id, arguments.number, AUTHOR,
                    arguments.text, status=status)

    def done_command(arguments):
        add_message(find_change(arguments.change).change_id, arguments.number, AUTHOR,
                    arguments.text or DONE, status=RESOLVED)

    def answer_command(_arguments):
        count = answer(sys.stdin.read())
        print(f'{count} answer(s) added')

    def status_command(arguments):
        set_status(find_change(arguments.change).change_id, arguments.number, arguments.status,
                   arguments.text)

    def vote_command(arguments):
        change = find_change(arguments.change)
        number = set_vote(change.change_id, arguments.label, arguments.value, arguments.by,
                          arguments.patch_set, arguments.message or '')
        print(f'{change.short_id()}: {label_name(arguments.label)}{arguments.value:+d} on PS{number}')

    def require_verified_command(arguments):
        require_verified(find_change(arguments.change).change_id, 'off' != arguments.state)

    def diff_run(arguments):
        change = find_change(arguments.change)
        subprocess.run(diff_command(change, arguments.first, arguments.second, arguments.tool))

    def range_diff_run(arguments):
        change = find_change(arguments.change)
        subprocess.run(range_diff_command(change, arguments.first, arguments.second))

    def author_repositories(arguments):
        # The working directory's repository, all registered ones outside a
        # repository or with --all
        if arguments.repositories:
            return arguments.repositories
        if arguments.all or toplevel() is None:
            return review_repositories(arguments.list)
        return ['.']

    def inbox_command(arguments):
        print('\n'.join(inbox_lines(author_repositories(arguments), arguments.topic))
              or 'Nothing to answer.')

    def watch_command(arguments):
        with contextlib.suppress(KeyboardInterrupt):
            watch(author_repositories(arguments), topic=arguments.topic)

    def register_command(arguments):
        print(f'registered as {register_repository(arguments.path, arguments.name, arguments.list)}')

    def unregister_command(arguments):
        unregister_repository(arguments.name)

    def repos_command(_arguments):
        lists = repository_lists()
        for name, path in registered_repositories().items():
            member = [list_name for list_name, names in lists.items() if name in names]
            print(f'{name:<16} {path}' + (f'  ({", ".join(member)})' if member else ''))

    def stack_command(run):
        def stack_run(arguments):
            name, colon, topic = arguments.topic.rpartition(':')
            repository = registered_repositories().get(name) if colon else None
            if colon and repository is None:
                raise ChangeError(f'no registered repository {name}')
            run(topic, repository)
            print(f'{topic}: ' + ('abandoned' if abandon_stack == run else 'restored'))
        return stack_run

    def guide_command(_arguments):
        print(guide_text(), end='')

    def serve_command(arguments):
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        import plustwo_web  # pylint: disable=import-outside-toplevel
        repositories = arguments.repositories or review_repositories(arguments.list)
        for repository in repositories:
            ensure_layout(repository)
        plustwo_web.serve(sys.modules[__name__], repositories, arguments.port)

    def hook_command(arguments):
        add_change_id(arguments.message_file)

    optional = {'nargs': '?'}
    number = ('number', {'type': int})
    repositories = ('repositories', {'nargs': '*'})
    command('init', init_command, 'set up this repository')
    command('list', print_overview, 'the dashboard').add_argument(
        '--list', help='only the repositories of this list', default=argparse.SUPPRESS)
    command('show', print_comments, 'threads of a change', 'change')
    upload_parser = command('upload', upload_command, 'upload the stack of a branch',
                            ('change', optional))
    upload_parser.add_argument('--topic')
    upload_parser.add_argument('--wip', action='store_true', help='mark it work in progress')
    upload_parser.add_argument('--ready', action='store_true', help='mark it ready for review')
    command('pull', pull_command, "bring the reviewer's rebase or submit into the branch")
    command('rebase', rebase_command, 'rebase a stack onto the base branch',
            ('change', optional)).add_argument('--topic')
    command('submit', submit_command, 'end the review', 'change')
    command('diff', diff_run, 'diff between patch sets', 'change', ('first', optional),
            ('second', optional)).add_argument('--tool', action='store_true')
    command('rdiff', range_diff_run, 'range-diff between patch sets', 'change',
            ('first', optional), ('second', optional))
    comment = command('comment', comment_command, 'add a comment', 'change', 'place', 'text')
    comment.add_argument('--author', action='store_true', help="the author's comment")
    status_choices = {'choices': STATUSES + tuple(OLD_STATUSES)}
    comment.add_argument('--status', default=UNRESOLVED, **status_choices)
    comment.add_argument('--resolved', action='store_const', const=RESOLVED, dest='status',
                         help='start the thread resolved, e.g. a note')
    reply = command('reply', reply_command, 'answer a thread', 'change', number, 'text')
    reply.add_argument('--resolve', action='store_true', help='and resolve the thread')
    reply.add_argument('--unresolve', action='store_true', help='and make it unresolved again')
    command('answer', answer_command, 'answer several threads at once, from stdin')
    command('done', done_command, 'answer "Done" and resolve the thread', 'change', number,
            ('text', optional))
    command('status', status_command, 'resolve a thread or make it unresolved again', 'change',
            number, ('status', status_choices), ('text', optional))
    vote = command('vote', vote_command, 'vote on a patch set', 'change', 'label',
                   ('value', {'type': int}))
    vote.add_argument('--by')
    vote.add_argument('--patch-set', type=int)
    vote.add_argument('-m', '--message')
    command('require-verified', require_verified_command, 'whether Verified+1 is needed',
            'change', ('state', {'nargs': '?', 'choices': ('on', 'off'), 'default': 'on'}))
    for name, run, help_text in (('inbox', inbox_command, 'what to answer'),
                                 ('watch', watch_command, 'print new messages and votes')):
        sub = command(name, run, help_text, repositories)
        sub.add_argument('--topic', help='only this stack, e.g. for one of several agents')
        sub.add_argument('--all', action='store_true', help='all registered repositories')
        sub.add_argument('--list', help='the repositories of this list', default=argparse.SUPPRESS)
    register = command('register', register_command, 'show a repository in the dashboard',
                       ('path', {'nargs': '?', 'default': '.'}))
    register.add_argument('--name')
    register.add_argument('--list', help='add it to this list of repositories')
    command('unregister', unregister_command, 'forget a registered repository', 'name')
    command('repos', repos_command, 'the registered repositories')
    command('check', check_command, 'run the check of a stack now, votes Verified',
            ('topic', optional))
    check_run = commands.add_parser('check-run', help=argparse.SUPPRESS)
    check_run.add_argument('topic')
    check_run.add_argument('commit')
    check_run.set_defaults(run=check_run_command)
    command('abandon', stack_command(abandon_stack), 'abandon a stack, [REPO:]TOPIC', 'topic')
    command('restore', stack_command(restore_stack), 'bring an abandoned stack back', 'topic')
    command('guide', guide_command, 'the guide for agents as authors')
    serve = command('serve', serve_command, 'web interface', repositories)
    serve.add_argument('--port', type=int, default=8022)
    serve.add_argument('--list', help='the repositories of this list', default=argparse.SUPPRESS)
    config = command('config', config_command, 'show or change a setting', ('key', optional),
                     ('value', optional))
    config.add_argument('--global', dest='user', action='store_true',
                        help="the user's settings instead of the repository's")
    config.add_argument('--unset', action='store_true', help='remove the setting')
    hook = commands.add_parser('commit-msg-hook', help=argparse.SUPPRESS)
    hook.add_argument('message_file')
    hook.set_defaults(run=hook_command)

    return parser.parse_args(argv)


def main(argv):
    """Runs one command. Returns the exit code."""
    arguments = parse_arguments(argv)
    try:
        arguments.run(arguments)
    except ChangeError as error:
        print(f'plustwo: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
