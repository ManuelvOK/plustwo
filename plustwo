#!/usr/bin/env python3
# SPDX-License-Identifier: Zlib
"""plustwo: Gerrit-like review of local commits, with patch sets and notes.

Starts the command line. The code is the package in src/plustwo next to
this file, found through links to it as well. Every command is described
in src/plustwo/cli/main.py and by plustwo --help.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / 'src'))

from plustwo.cli.main import main  # noqa: E402 pylint: disable=wrong-import-position

if '__main__' == __name__:
    sys.exit(main(sys.argv[1:]))
